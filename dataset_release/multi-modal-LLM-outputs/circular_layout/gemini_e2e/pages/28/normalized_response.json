            144,
            194,
            175,
            574
          ],
          "text": "अष्टमेपटले श्लोक २५ कामप्रयोगविधिः"
        },
        {
          "id": "line_1",
          "box_2d": [
            171,
            194,
            201,
            582
          ],
          "text": "अष्टमेपटले श्लोक ३- चतुर्दशंयंत्रोद्धारः"
        },
        {
          "id": "line_2",
          "box_2d": [
            198,
            194,
            227,
            567
          ],
          "text": "अष्टमेपटले श्लोक ३० अमृतपंचकोद्धारः"
        },
        {
          "id": "line_3",
          "box_2d": [
            224,
            194,
            254,
            614
          ],
          "text": "तद्यथा ज १ क २ ठ ३ व ४ स ५ इत्यमृतपंचकम्"
        },
        {
          "id": "line_4",
          "box_2d": [
            249,
            194,
            274,
            488
          ],
          "text": "तत्रबिन्दुयोगे जं कं ठं वं सं पंच"
        },
        {
          "id": "line_5",
          "box_2d": [
            269,
            195,
            296,
            645
          ],
          "text": "विसर्गयोगेच जः कः ठः वः सः पंच इत्येवदशभवंति"
        },
        {
          "id": "line_6",
          "box_2d": [
            291,
            194,
            321,
            641
          ],
          "text": "तेषां प्रत्येकं षोडशाक्षरसंयोगेसति षष्ट्युत्तरशतसंख्याका"
        },
        {
          "id": "line_7",
          "box_2d": [
            315,
            194,
            339,
            342
          ],
          "text": "अमृताणीजायंते"
        },
        {
          "id": "line_8",
          "box_2d": [
            336,
            194,
            363,
            622
          ],
          "text": "अत्रापिएठाज्ञएविहाय द्वादशस्वराणामेवामृताक्षर"
        },
        {
          "id": "line_9",
          "box_2d": [
            356,
            194,
            385,
            678
          ],
          "text": "योगेसन्निर्विक्षामुत्तरशतसंख्याका एव अमृताणीजायंते"
        },
        {
          "id": "line_10",
          "box_2d": [
            421,
            204,
            448,
            715
          ],
          "text": "एषुचतुर्दशायंत्रेषु मध्यत्रिकोणेमायागर्भगतंसाध्यंविधेयम्"
        }
      ]
    },
