			<TextLine id="line_9">
				<Coords points="332,263 2258,263 2258,183 332,183" />
				<TextEquiv>
					<Unicode>तस्मात्त्वः प्रात्रिः प्रोपुत्रपौत्रप्रपौत्रकैः॥ यस्मात्तस्मात्त्रियः सेव्या कर्तव्याश्च सुरक्षिताः॥ षोडशर्तु निशा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_6" custom="region_6">
			<Coords points="332,328 2238,328 2238,250 332,250" />
			<TextLine id="line_10">
				<Coords points="332,328 2238,328 2238,250 332,250" />
				<TextEquiv>
					<Unicode>स्त्रीणां तस्मिन् युग्मासु संविशेत्॥ युग्मासु पुत्रा जायंते स्त्रियोऽयुग्मासु रात्रिषु॥ ब्रह्मचर्येव पर्वा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_6" custom="region_6">
			<Coords points="332,396 2238,396 2238,319 332,319" />
			<TextLine id="line_11">
				<Coords points="332,396 2238,396 2238,319 332,319" />
				<TextEquiv>
					<Unicode>ण्याद्याश्चतस्रश्च वर्जयेत्॥ ऋतौ तु के गर्भसंकिलात्स्नानं मैथुनिनः स्मृता॥ अनृतौ तु सदा कार्यशौ</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_6" custom="region_6">
			<Coords points="332,461 2238,461 2238,383 332,383" />
			<TextLine id="line_12">
				<Coords points="332,461 2238,461 2238,383 332,383" />
				<TextEquiv>
					<Unicode>चं मूत्रपुरीषवत्॥ एवं गच्छन् स्त्रियं क्षामां मघा मूलं च वर्जयेत्॥ सुस्थेंदौ सकलपुत्रलक्षणयुंजना</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_6" custom="region_6">
			<Coords points="332,528 2238,528 2238,450 332,450" />
			<TextLine id="line_13">
				<Coords points="332,528 2238,528 2238,450 332,450" />
				<TextEquiv>
					<Unicode>येत्पुमान्॥ यथाकामी भवेद्वापि स्त्रीणां वरमनुस्मरन्॥ स्वदारनिरतश्चैव स्त्रियो रक्ष्या यतः स्मृ</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_6" custom="region_6">
			<Coords points="332,593 2238,593 2238,515 332,515" />
			<TextLine id="line_14">
				<Coords points="332,593 2238,593 2238,515 332,515" />
				<TextEquiv>
					<Unicode>ताः॥ भर्त्तृ भ्रातृ पितृ ज्ञातिश्वश्रूश्वशुरदेवरैः॥ बंधुभिश्च स्त्रियः पूज्या भूषणच्छादनाशनैः॥ सं</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_6" custom="region_6">
			<Coords points="332,659 2238,659 2238,580 332,580" />
			<TextLine id="line_15">
				<Coords points="332,659 2238,659 2238,580 332,580" />
				<TextEquiv>
					<Unicode>तोपस्करा दक्षा हृष्टा व्ययपराङ्मुखी॥ कुर्याच्छ्वशुरयोः पादवंदनं भर्त्तृ तत्परा॥ क्रीडां शारी</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
