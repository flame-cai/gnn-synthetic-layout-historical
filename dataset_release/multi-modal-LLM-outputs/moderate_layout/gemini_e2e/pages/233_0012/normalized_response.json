    {
      "id": "region_6",
      "type": "main_text",
      "box_2d": [
        198,
        133,
        782,
        903
      ],
      "lines": [
        {
          "id": "line_9",
          "box_2d": [
            198,
            133,
            284,
            903
          ],
          "text": "तस्मात्त्वः प्रात्रिः प्रोपुत्रपौत्रप्रपौत्रकैः॥ यस्मात्तस्मात्त्रियः सेव्या कर्तव्याश्च सुरक्षिताः॥ षोडशर्तु निशा"
        },
        {
          "id": "line_10",
          "box_2d": [
            270,
            133,
            354,
            895
          ],
          "text": "स्त्रीणां तस्मिन् युग्मासु संविशेत्॥ युग्मासु पुत्रा जायंते स्त्रियोऽयुग्मासु रात्रिषु॥ ब्रह्मचर्येव पर्वा"
        },
        {
          "id": "line_11",
          "box_2d": [
            344,
            133,
            428,
            895
          ],
          "text": "ण्याद्याश्चतस्रश्च वर्जयेत्॥ ऋतौ तु के गर्भसंकिलात्स्नानं मैथुनिनः स्मृता॥ अनृतौ तु सदा कार्यशौ"
        },
        {
          "id": "line_12",
          "box_2d": [
            414,
            133,
            498,
            895
          ],
          "text": "चं मूत्रपुरीषवत्॥ एवं गच्छन् स्त्रियं क्षामां मघा मूलं च वर्जयेत्॥ सुस्थेंदौ सकलपुत्रलक्षणयुंजना"
        },
        {
          "id": "line_13",
          "box_2d": [
            486,
            133,
            570,
            895
          ],
          "text": "येत्पुमान्॥ यथाकामी भवेद्वापि स्त्रीणां वरमनुस्मरन्॥ स्वदारनिरतश्चैव स्त्रियो रक्ष्या यतः स्मृ"
        },
        {
          "id": "line_14",
          "box_2d": [
            556,
            133,
            640,
            895
          ],
          "text": "ताः॥ भर्त्तृ भ्रातृ पितृ ज्ञातिश्वश्रूश्वशुरदेवरैः॥ बंधुभिश्च स्त्रियः पूज्या भूषणच्छादनाशनैः॥ सं"
        },
        {
          "id": "line_15",
          "box_2d": [
            626,
            133,
            712,
            895
          ],
          "text": "तोपस्करा दक्षा हृष्टा व्ययपराङ्मुखी॥ कुर्याच्छ्वशुरयोः पादवंदनं भर्त्तृ तत्परा॥ क्रीडां शारी"
        },
        {
          "id": "line_16",
          "box_2d": [
            696,
            133,
            782,
            895
          ],
          "text": "रसंस्कारं महोत्सवदर्शनं॥ हास्यं परगृहे यानं त्यजेत्प्रोषितभर्त्तृका॥ रक्षेत्कन्यां पिता वि"
        }
      ]
    },
