		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,290 2212,290 2212,208 310,208" />
			<TextLine id="line_10">
				<Coords points="310,290 2212,290 2212,208 310,208" />
				<TextEquiv>
					<Unicode>शूद्राज्जातस्तु चांडालः सर्वधर्मबहिष्कृतः ॥ क्षत्रिया मागधं वैश्याच्छूद्रात्क्षत्तारमेव च ॥ शूद्रादायोगवं</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,347 2212,347 2212,263 310,263" />
			<TextLine id="line_11">
				<Coords points="310,347 2212,347 2212,263 310,263" />
				<TextEquiv>
					<Unicode>वैश्या जनयामास वै सुतं ॥ माहिष्येण करण्यां तु रथकारः प्रजायते ॥ असत्संतस्तु विज्ञेयाः प्रतिलोमा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,402 2212,402 2212,317 310,317" />
			<TextLine id="line_12">
				<Coords points="310,402 2212,402 2212,317 310,317" />
				<TextEquiv>
					<Unicode>नुलोमजाः ॥ जात्युत्कर्षो युगे ज्ञेयः सप्तमे पंचमेऽपि वा ॥ व्यत्यये कर्मणां साम्यं पूर्ववच्चाधरोत्तरं ॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,468 2212,468 2212,389 310,389" />
			<TextLine id="line_13">
				<Coords points="310,468 2212,468 2212,389 310,389" />
				<TextEquiv>
					<Unicode>इति वर्णजातिप्रकरणं ॥ कर्म स्मार्त्तं विवाहाग्नौ कुर्वीत प्रत्यहं गृही ॥ दायकालाहृते वापि श्रौ</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,529 2212,529 2212,444 310,444" />
			<TextLine id="line_14">
				<Coords points="310,529 2212,529 2212,444 310,444" />
				<TextEquiv>
					<Unicode>तं वैतानिकाग्निषु ॥ शारीरचिंतां निर्वर्त्य कृतशौचविधिर्द्विजः ॥ प्रातःसंध्यामुपासीत दंतधावनपू</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,602 2212,602 2212,517 310,517" />
			<TextLine id="line_15">
				<Coords points="310,602 2212,602 2212,517 310,517" />
				<TextEquiv>
					<Unicode>र्वकं ॥ हुत्वाग्नीन्सूर्यदैवत्यान्जपेन्मंत्रान्समाहितः ॥ वेदार्थानधिगच्छेच्च शास्त्राणि विवि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,667 2212,667 2212,582 310,582" />
			<TextLine id="line_16">
				<Coords points="310,667 2212,667 2212,582 310,582" />
				<TextEquiv>
					<Unicode>धानि च ॥ उपेयादीश्वरं चैव योगक्षेमार्थसिद्धये ॥ स्नात्वा देवान्पितॄंश्चैव तर्पयेदर्च्चयेत्तथा ॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_10" custom="region_10">
			<Coords points="310,740 2378,740 2378,648 310,648" />
			<TextLine id="line_17">
				<Coords points="310,740 2378,740 2378,648 310,648" />
				<TextEquiv>
					<Unicode>वेदाथर्वपुराणानि सेतिहासानि शक्तितः ॥ जपयज्ञप्रसिद्ध्यर्थं विद्यां चाध्यात्मिकीं जपेत् ॥ राम १</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
