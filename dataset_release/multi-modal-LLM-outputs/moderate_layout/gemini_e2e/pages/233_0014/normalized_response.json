        }
      ]
    },
    {
      "id": "region_10",
      "type": "main_text",
      "polygon_2d": [
        [
          228,
          124
        ],
        [
          228,
          885
        ],
        [
          811,
          885
        ],
        [
          811,
          124
        ]
      ],
      "lines": [
        {
          "id": "line_10",
          "box_2d": [
            228,
            124,
            318,
            885
          ],
          "text": "शूद्राज्जातस्तु चांडालः सर्वधर्मबहिष्कृतः ॥ क्षत्रिया मागधं वैश्याच्छूद्रात्क्षत्तारमेव च ॥ शूद्रादायोगवं"
        },
        {
          "id": "line_11",
          "box_2d": [
            288,
            124,
            381,
            885
          ],
          "text": "वैश्या जनयामास वै सुतं ॥ माहिष्येण करण्यां तु रथकारः प्रजायते ॥ असत्संतस्तु विज्ञेयाः प्रतिलोमा"
        },
        {
          "id": "line_12",
          "box_2d": [
            348,
            124,
            441,
            885
          ],
          "text": "नुलोमजाः ॥ जात्युत्कर्षो युगे ज्ञेयः सप्तमे पंचमेऽपि वा ॥ व्यत्यये कर्मणां साम्यं पूर्ववच्चाधरोत्तरं ॥"
        },
        {
          "id": "line_13",
          "box_2d": [
            427,
            124,
            513,
            885
          ],
          "text": "इति वर्णजातिप्रकरणं ॥ कर्म स्मार्त्तं विवाहाग्नौ कुर्वीत प्रत्यहं गृही ॥ दायकालाहृते वापि श्रौ"
        },
        {
          "id": "line_14",
          "box_2d": [
            487,
            124,
            580,
            885
          ],
          "text": "तं वैतानिकाग्निषु ॥ शारीरचिंतां निर्वर्त्य कृतशौचविधिर्द्विजः ॥ प्रातःसंध्यामुपासीत दंतधावनपू"
        },
        {
          "id": "line_15",
          "box_2d": [
            567,
            124,
            660,
            885
          ],
          "text": "र्वकं ॥ हुत्वाग्नीन्सूर्यदैवत्यान्जपेन्मंत्रान्समाहितः ॥ वेदार्थानधिगच्छेच्च शास्त्राणि विवि"
        },
        {
          "id": "line_16",
          "box_2d": [
            638,
            124,
            731,
            885
          ],
          "text": "धानि च ॥ उपेयादीश्वरं चैव योगक्षेमार्थसिद्धये ॥ स्नात्वा देवान्पितॄंश्चैव तर्पयेदर्च्चयेत्तथा ॥"
        },
        {
          "id": "line_17",
          "box_2d": [
            711,
            124,
            811,
            951
          ],
          "text": "वेदाथर्वपुराणानि सेतिहासानि शक्तितः ॥ जपयज्ञप्रसिद्ध्यर्थं विद्यां चाध्यात्मिकीं जपेत् ॥ राम १"
        }
      ]
    },
