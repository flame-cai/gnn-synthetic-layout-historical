      "lines": [
        {
          "id": "line_0",
          "box_2d": [
            61,
            311,
            114,
            740
          ],
          "text": "शास्त्रविरुद्धः १ ॥ प्रत्रैपाद्यं च बुद्धौ संस्थाप्य वक्ता = सव्यजुः समपाठकाः २ ="
        },
        {
          "id": "line_1",
          "box_2d": [
            110,
            417,
            161,
            634
          ],
          "text": "रात्रौ यात्र देवकार्यं नातुदोषाय तं ३ ="
        },
        {
          "id": "line_2",
          "box_2d": [
            51,
            801,
            100,
            932
          ],
          "text": "एतेषां कर्मणां मध्ये १ ="
        },
        {
          "id": "line_3",
          "box_2d": [
            161,
            134,
            226,
            209
          ],
          "text": "M-233"
        },
        {
          "id": "line_4",
          "box_2d": [
            171,
            824,
            226,
            848
          ],
          "text": "३"
        },
        {
          "id": "line_5",
          "box_2d": [
            425,
            66,
            497,
            101
          ],
          "text": "घोर"
        },
        {
          "id": "line_6",
          "box_2d": [
            532,
            24,
            611,
            119
          ],
          "text": "तरुकार्यः ३"
        },
        {
          "id": "line_7",
          "box_2d": [
            238,
            142,
            321,
            858
          ],
          "text": "मनः ॥ संम्यक्संकल्पजः कामोधर्ममूलमिदं स्मृतम् ॥ इज्याचारदमाहिंसादानस्वाध्याय कर्मणाम् ॥"
        },
        {
          "id": "line_8",
          "box_2d": [
            308,
            140,
            395,
            952
          ],
          "text": "अयं तु परमो धर्मो यद्योगेनात्मदर्शनम् ॥ चत्वारो वेदा धर्मज्ञाः पर्ष त्रैविद्यमेव वा ॥ सा ब्रूते यं स धर्मः स्यात् २ ="
        },
        {
          "id": "line_9",
          "box_2d": [
            393,
            140,
            477,
            814
          ],
          "text": "स्यादेको वाध्यात्मवित्तमः ॥ इति उपोद्घातप्रकरणं ॥ ब्रह्मक्षत्रियविट्शूद्रा वर्णास्त्वाद्यास्त्रयो द्विजाः"
        },
        {
          "id": "line_10",
          "box_2d": [
            463,
            140,
            545,
            982
          ],
          "text": "निषेकाद्या श्मशानांतास्तेषां वै मंत्रतः क्रियाः ॥ गर्भाधानमृतौ पुंसः सवनं स्पंदनात्पुरा ॥ षष्ठे = दंतधावनं ॥ ४ ="
        },
        {
          "id": "line_11",
          "box_2d": [
            538,
            142,
            619,
            880
          ],
          "text": "एमेच सीमंतोन्नास्येते जातकर्म च ॥ अह्न्येकादशे नाम चतुर्थे मासि निष्क्रमः ॥ षष्ठेन्नप्राशनं मा"
        },
        {
          "id": "line_12",
          "box_2d": [
            611,
            144,
            699,
            882
          ],
          "text": "सि चूडाकार्या यथाकुलं ॥ एवमेनः शमंयाति वीर्यगर्भसमुद्भवम् ॥ तूष्णीमेताः क्रियाः स्त्रीणां"
        },
        {
          "id": "line_13",
          "box_2d": [
            685,
            148,
            781,
            880
          ],
          "text": "विवाहस्तु समंत्रकः ॥ गर्भाष्टमेष्टमे वाब्दे ब्राह्मणस्योपनायनं ॥ राज्ञामेकादशे सैके वि"
        },
        {
          "id": "line_14",
          "box_2d": [
            785,
            290,
            893,
            437
          ],
          "text": "जातकर्मप्रसंगेन कार्यः ३"
        },
        {
          "id": "line_15",
          "box_2d": [
            774,
            461,
            829,
            532
          ],
          "text": "नग्ननः १"
        },
        {
          "id": "line_16",
          "box_2d": [
            754,
            614,
            814,
            728
          ],
          "text": "यज्ञोपवीतं कार्यं १"
        }
      ]
    }
