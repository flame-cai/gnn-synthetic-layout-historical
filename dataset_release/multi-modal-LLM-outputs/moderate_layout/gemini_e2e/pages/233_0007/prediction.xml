			<TextLine id="line_5">
				<Coords points="312,646 2225,646 2225,565 312,565" />
				<TextEquiv>
					<Unicode>तु सोमघृतैर्देवांस्तर्पयेद्योऽन्वहं पठेत्॥ सामानि तर्पिंकुर्याच्च पितॄणां मधुसर्पिषा॥ मेदसातर्प</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
