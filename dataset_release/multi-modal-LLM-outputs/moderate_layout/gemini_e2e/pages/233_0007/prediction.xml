				<Coords points="312,294 2238,294 2238,218 312,218" />
				<TextEquiv>
					<Unicode>रात्॥ ब्रह्मक्षत्रियविशां काल औपनायनिकः परः॥ अतः ऊर्ध्वं पतंते ते सर्वधर्मबहिष्कृताः॥ सावित्री</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="312,366 2238,366 2238,276 312,276" />
			<TextLine id="line_1">
				<Coords points="312,366 2238,366 2238,276 312,276" />
				<TextEquiv>
					<Unicode>पतिता व्रात्या व्रात्यस्तोमादृते क्रतोः॥ मातुर्यदग्रे जायते द्वितीयं मौंजिबंधनात्॥ ब्राह्मणक्षत्रियविशा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="312,437 2225,437 2225,352 312,352" />
			<TextLine id="line_2">
				<Coords points="312,437 2225,437 2225,352 312,352" />
				<TextEquiv>
					<Unicode>त्तस्मादेते द्विजाः स्मृताः॥ यज्ञानां तपसां चैव शुभानां चैव कर्मणाम्॥ वेद एव द्विजातीनां निःश्रे</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="312,508 2225,508 2225,428 312,428" />
			<TextLine id="line_3">
				<Coords points="312,508 2225,508 2225,428 312,428" />
				<TextEquiv>
					<Unicode>यसकरः परः॥ मधुना पयसा चैव स देवांस्तर्पयेद् द्विजः॥ पितॄन् दधिघृताभ्यां च यश्चाप्यधीतेऽनुयोज</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="312,580 2225,580 2225,499 312,499" />
			<TextLine id="line_4">
				<Coords points="312,580 2225,580 2225,499 312,499" />
				<TextEquiv>
					<Unicode>हं॥ यद्यद्विप्रा ऋचोऽधीते योऽन्वहं मधुतर्पतः॥ प्रीणाति देवान् सोऽनेन मधुना चापि पितॄंस्तथा॥ स</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
