					<Unicode>योगिनां शमकर्त्ता नामीश्वरं २=</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="295,268 2240,268 2240,181 295,181" />
			<TextLine id="line_2">
				<Coords points="295,268 2240,268 2240,181 295,181" />
				<TextEquiv>
					<Unicode>याज्ञव० १ ॐ स्वस्ति श्रीगणेशाय नमः ॥ ॐ श्रीगुरवे नमः ॥ ॐ श्रीसरस्वत्यै नमः ॥ ॐ श्रीयोगपतये नमः ॥ रामाय नमः ॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="295,346 2445,346 2445,252 295,252" />
			<TextLine id="line_3">
				<Coords points="295,346 2445,346 2445,252 295,252" />
				<TextEquiv>
					<Unicode>योगेश्वरं याज्ञवल्क्यं संपूज्य मुनयोऽब्रुवन् ॥ वर्णाश्रमेतराणां नो ब्रूहि धर्मानशेषतः ॥ मिथिलास्थः स योगीश्वरः २</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="295,415 2185,415 2185,329 295,329" />
			<TextLine id="line_4">
				<Coords points="295,415 2185,415 2185,329 295,329" />
				<TextEquiv>
					<Unicode>स योगींद्रः क्षणं ध्यात्वा ब्रवीन्मुनीन् यस्मिन् देशे मृगः कृष्णस्तस्मिन् धर्मान् विबोधत ॥ पुराणन्या</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="305,489 2185,489 2185,404 305,404" />
			<TextLine id="line_5">
				<Coords points="305,489 2185,489 2185,404 305,404" />
				<TextEquiv>
					<Unicode>यमीमांसाधर्मशास्त्रांगमिश्रिताः ॥ वेदाः स्थानानि विद्यानां धर्मस्य च चतुर्दश ॥ मन्वत्रिविष्णुहा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
