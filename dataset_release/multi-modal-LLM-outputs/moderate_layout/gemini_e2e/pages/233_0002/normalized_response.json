      "lines": [
        {
          "id": "line_0",
          "box_2d": [
            49,
            203,
            102,
            631
          ],
          "text": "शिक्षा कल्पो व्याकरणं निरुक्तं ज्योति छंदसी ॥४॥ स तस्माद् वेदमविहरत् ॥३॥"
        },
        {
          "id": "line_1",
          "box_2d": [
            193,
            14,
            401,
            119
          ],
          "text": "योगिनां शमकर्त्ता नामीश्वरं २="
        },
        {
          "id": "line_2",
          "box_2d": [
            193,
            118,
            285,
            896
          ],
          "text": "याज्ञव० १ ॐ स्वस्ति श्रीगणेशाय नमः ॥ ॐ श्रीगुरवे नमः ॥ ॐ श्रीसरस्वत्यै नमः ॥ ॐ श्रीयोगपतये नमः ॥ रामाय नमः ॥"
        },
        {
          "id": "line_3",
          "box_2d": [
            268,
            118,
            368,
            978
          ],
          "text": "योगेश्वरं याज्ञवल्क्यं संपूज्य मुनयोऽब्रुवन् ॥ वर्णाश्रमेतराणां नो ब्रूहि धर्मानशेषतः ॥ मिथिलास्थः स योगीश्वरः २"
        },
        {
          "id": "line_4",
          "box_2d": [
            350,
            118,
            442,
            874
          ],
          "text": "स योगींद्रः क्षणं ध्यात्वा ब्रवीन्मुनीन् यस्मिन् देशे मृगः कृष्णस्तस्मिन् धर्मान् विबोधत ॥ पुराणन्या"
        },
        {
          "id": "line_5",
          "box_2d": [
            430,
            122,
            520,
            874
          ],
          "text": "यमीमांसाधर्मशास्त्रांगमिश्रिताः ॥ वेदाः स्थानानि विद्यानां धर्मस्य च चतुर्दश ॥ मन्वत्रिविष्णुहा"
        },
        {
          "id": "line_6",
          "box_2d": [
            500,
            122,
            595,
            878
          ],
          "text": "रीतयाज्ञवल्क्योशनोंगिराः ॥ यमापस्तंबसंवर्त्तकात्यायनबृहस्पती ॥ पराशरव्यासशंख"
        },
        {
          "id": "line_7",
          "box_2d": [
            580,
            122,
            670,
            872
          ],
          "text": "लिखिता दक्षगौतमौ ॥ शातातपो वशिष्ठश्च धर्मशास्त्रप्रयोजकाः ॥ देशे काल उपायेन द्रव्यं श्र"
        },
        {
          "id": "line_8",
          "box_2d": [
            650,
            122,
            745,
            945
          ],
          "text": "द्धासमन्वितं पात्रे प्रदीयतें यत्तत् सकलं धर्मलक्षणं ॥ श्रुतिः स्मृतिः सदाचारः स्वस्य च प्रियमात्मनः राम १"
        },
        {
          "id": "line_9",
          "box_2d": [
            735,
            655,
            795,
            801
          ],
          "text": "सतामाचारः सदाचारः १"
        },
        {
          "id": "line_10",
          "box_2d": [
            835,
            655,
            905,
            950
          ],
          "text": "॥ देशे उक्तलक्षणे ॥ काले संक्रांत्यादौ ॥ उपायेनोपार्जनं ॥२॥"
        }
      ]
    }
  ]
}