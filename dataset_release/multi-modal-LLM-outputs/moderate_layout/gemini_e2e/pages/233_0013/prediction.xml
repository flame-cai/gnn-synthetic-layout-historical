			<TextLine id="line_7">
				<Coords points="308,287 2238,287 2238,204 308,204" />
				<TextEquiv>
					<Unicode>नोतिः पुत्राश्च वार्द्धके ॥ मृजावेतातयस्तेषां स्वातंत्र्यं न क्वचित् स्त्रियाः ॥ पितृमातृसुतभ्रातृश्व</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,352 2238,352 2238,278 312,278" />
			<TextLine id="line_8">
				<Coords points="312,352 2238,352 2238,278 312,278" />
				<TextEquiv>
					<Unicode>शूश्वशुरमातुलैः ॥ हीना न स्याद्विना भर्त्रा गर्हणीयान्यथा भवेत् ॥ पतिप्रियहिते युक्ता स्वाचा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,417 2238,417 2238,338 312,338" />
			<TextLine id="line_9">
				<Coords points="312,417 2238,417 2238,338 312,338" />
				<TextEquiv>
					<Unicode>रा विजितेन्द्रिया ॥ सेह कीर्त्तिमवाप्नोति प्रेत्य चानुत्तमां गतिं ॥ स व्यामन्द्या सवर्णीयां धर्म्मकार्यं</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,482 2238,482 2238,403 312,403" />
			<TextLine id="line_10">
				<Coords points="312,482 2238,482 2238,403 312,403" />
				<TextEquiv>
					<Unicode>न कारयेत् ॥ सवर्णासु विधौ धर्म्मे ज्येष्ठयान विनेतराः ॥ दाहयित्वाग्निहोत्रेण स्त्रियं वृत्तवतीं पतिः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,546 2238,546 2238,472 312,472" />
			<TextLine id="line_11">
				<Coords points="312,546 2238,546 2238,472 312,472" />
				<TextEquiv>
					<Unicode>आहरेद्विधिवद्दारानग्नींश्चाविलंबयन् ॥ इति विवाहप्रकरणं ॥ सवर्णेभ्यः सवर्णासु जायन्ते</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,607 2238,607 2238,528 312,528" />
			<TextLine id="line_12">
				<Coords points="312,607 2238,607 2238,528 312,528" />
				<TextEquiv>
					<Unicode>हिसजातियः ॥ अप्रशस्तेषु विवाहेषु पुत्राः संतानवर्द्धनाः ॥ विप्रात्त्रिमूर्द्धावसितो हि क्षत्रियायां विशस्तु</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,671 2238,671 2238,588 312,588" />
			<TextLine id="line_13">
				<Coords points="312,671 2238,671 2238,588 312,588" />
				<TextEquiv>
					<Unicode>यां ॥ अंबष्ठः शूद्र्यां निषादो जातः पारशवोऽपि वा ॥ वैश्या शूद्रोस्तु राजन्यान्माहिष्योग्रौ सुतौ स्मृतौ</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_7" custom="region_7">
			<Coords points="312,736 2238,736 2238,657 312,657" />
			<TextLine id="line_14">
				<Coords points="312,736 2238,736 2238,657 312,657" />
				<TextEquiv>
					<Unicode>॥ वैश्यात्तु करणाच्छूद्र्यां विन्नास्वेष विधिः स्मृतः ॥ ब्राह्मण्यां क्षत्रियात्सूतो वैश्याद्वैदेहिकस्तथा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
