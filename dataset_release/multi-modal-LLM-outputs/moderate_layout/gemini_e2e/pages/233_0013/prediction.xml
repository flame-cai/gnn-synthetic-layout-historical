			<TextLine id="line_0">
				<Coords points="320,102 2445,102 2445,39 320,39" />
				<TextEquiv>
					<Unicode>द्वितीयां चैव यो भार्या दहेदग्निकाउनिभिः जीवंत्या प्रथमयानुसुरापन समं स्मृतं ॥४॥ मृतायां तु द्वितीयांतु योऽग्निहोत्र समुत्सृजेत् ब्रह्मघ्नं तं विजानी</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_1" custom="region_1">
			<Coords points="302,144 2045,144 2045,69 302,69" />
			<TextLine id="line_1">
				<Coords points="302,144 2045,144 2045,69 302,69" />
				<TextEquiv>
					<Unicode>ब्राह्मणेन क्षत्रियायां उत्पादितः क्षत्रियः एव क्षत्रियेण वैश्यायां उत्पादितः वैश्यः एव वैश्येन शूद्रायां उत्पादितः शूद्रः एव ॥६॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
