		<TextRegion id="main_text" custom="main_text">
			<Coords points="335,260 2195,260 2195,167 335,167" />
			<TextLine id="main_line_1">
				<Coords points="335,260 2195,260 2195,167 335,167" />
				<TextEquiv>
					<Unicode>ममं चेषांलक्षणं ज्ञेये॥ आदिमध्यावसानेषु न वै क्षेपोपलक्षिता॥ ब्राह्मराजन्यविशां भैक्षचर्या यथा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="main_text" custom="main_text">
			<Coords points="330,332 2202,332 2202,253 330,253" />
			<TextLine id="main_line_2">
				<Coords points="330,332 2202,332 2202,253 330,253" />
				<TextEquiv>
					<Unicode>क्रमं॥ कृताग्निकार्यो भुंजीत वाग्यतो गुर्वनुज्ञया॥ आपोशानक्रियापूर्व सत्कृत्यन्नमकुत्सय</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="main_text" custom="main_text">
			<Coords points="330,403 2210,403 2210,321 330,321" />
			<TextLine id="main_line_3">
				<Coords points="330,403 2210,403 2210,321 330,321" />
				<TextEquiv>
					<Unicode>न्॥ ब्रह्मचर्ये स्थितो नैकमन्नमद्यादनापदि॥ ब्राह्मणः काममश्नीयाच्छ्राद्धे व्रत मपीडयन्॥ अभ</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="main_text" custom="main_text">
			<Coords points="332,473 2212,473 2212,391 332,391" />
			<TextLine id="main_line_4">
				<Coords points="332,473 2212,473 2212,391 332,391" />
				<TextEquiv>
					<Unicode>द्युमां संजनोच्छिष्ट सूत स्त्रीप्राणिहिंसनं॥ भास्करालेकनाश्लीलपरिवादादिवर्जयेत्॥ सः गुरुर्यः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="main_text" custom="main_text">
			<Coords points="325,545 2200,545 2200,464 325,464" />
			<TextLine id="main_line_5">
				<Coords points="325,545 2200,545 2200,464 325,464" />
				<TextEquiv>
					<Unicode>क्रियाकृत्वा वेदमस्मै प्रयच्छति॥ उपनीय ददेद्वे दमाचार्यः स उदाहृतः॥ एकदेशं मुध्यापयन्विज्यत</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="main_text" custom="main_text">
			<Coords points="328,614 2200,614 2200,534 328,534" />
			<TextLine id="main_line_6">
				<Coords points="328,614 2200,614 2200,534 328,534" />
				<TextEquiv>
					<Unicode>कदुच्यते॥ एते मान्या यथापूर्वमेभ्यो माता गरीयसी॥ प्रतिवेदं ब्रह्मचर्यं द्वादशाब्दानिपंच</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="main_text" custom="main_text">
			<Coords points="335,682 2202,682 2202,604 335,604" />
			<TextLine id="main_line_7">
				<Coords points="335,682 2202,682 2202,604 335,604" />
				<TextEquiv>
					<Unicode>वा॥ गृह्णांतिकमित्यन्ये के शांतश्चैव षोडशे॥ आषोडशात्कादाविंशाच्चतुर्विंशाच्चवत्स</Unicode>
				</TextEquiv>
			</TextLine>
