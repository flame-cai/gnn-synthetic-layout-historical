        794,
        878
      ],
      "lines": [
        {
          "id": "line_4",
          "box_2d": [
            213,
            126,
            304,
            874
          ],
          "text": "वैदिककर्मस्वधा होमस्वाध्यायातिथिसक्रियाः ॥ भूतयज्ञो मनुष्ययज्ञां महामखाः ॥ देवै"
        },
        {
          "id": "line_5",
          "box_2d": [
            288,
            126,
            373,
            876
          ],
          "text": "भ्यश्च हुतादन्नाच्छेषाद्भूतवलिं हरेत् ॥ अन्नं भूमौ श्वचांडालवायसेभ्यश्च क्षिपेत् ॥ अन्नं पितृमनुष्ये"
        },
        {
          "id": "line_6",
          "box_2d": [
            356,
            126,
            440,
            876
          ],
          "text": "भ्यो देयमप्यन्वहं जलं ॥ स्वाध्यायं चान्वहं कुर्यान्नैवेद्यन्नमात्मने ॥ बालखवासिनीवृद्धागर्भिण्यातुर"
        },
        {
          "id": "line_7",
          "box_2d": [
            424,
            126,
            510,
            876
          ],
          "text": "कन्यकाः ॥ संभोज्यातिथिभिः सार्द्धं दंपत्योः शेषभोजनं ॥ प्राणान्नहोत्रविधिना भुंजीत अन्नम"
        },
        {
          "id": "line_8",
          "box_2d": [
            497,
            126,
            579,
            876
          ],
          "text": "घापहं ॥ स्नातो विमुक्तकचश्चित्तमक्षतप्रीतिपूर्वकं ॥ आपोशानेनोपरिष्टाद्दद्यादम्मृतातप्य"
        },
        {
          "id": "line_9",
          "box_2d": [
            569,
            126,
            650,
            876
          ],
          "text": "अन्नग्नममतं चैव कार्यमन्ने द्विजन्मना ॥ अतिथित्वेन वरीयान्प्रादेयश्चानुपूर्वशः ॥ प्र"
        },
        {
          "id": "line_10",
          "box_2d": [
            639,
            123,
            722,
            870
          ],
          "text": "प्रणोद्योतिथिः सायमपि वाग्नूत् सृष्टोदकैः ॥ सकृत् सन्निहितेन स्यादातव्या सुव्रता पञ्चाग्नी"
        },
        {
          "id": "line_11",
          "box_2d": [
            711,
            123,
            794,
            878
          ],
          "text": "जयेद्वागतान्काले सखिसंबंधिबांधवान् ॥ प्ररोचनं महाजवाद्यो श्रिया चोपकल्पयेत् ॥ सकृ"
        }
      ]
    },
