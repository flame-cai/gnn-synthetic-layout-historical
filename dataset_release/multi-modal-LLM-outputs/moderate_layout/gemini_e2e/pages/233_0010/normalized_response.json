            250,
            105
          ],
          "text": "याज्ञव० ५="
        },
        {
          "id": "line_4",
          "box_2d": [
            190,
            120,
            265,
            885
          ],
          "text": "रौद्रविवादानात्गांधर्वःसमयान्विचयः॥राक्षसोयुद्धहरणात्पैशाचःकन्यकाछलात्॥काणो ग्राह्यः"
        },
        {
          "id": "line_5",
          "box_2d": [
            260,
            120,
            335,
            885
          ],
          "text": "सवर्णासुगृहीयात्क्षत्रियाशरं॥वैश्यांशूद्रोदमाद्दद्यादैनेत्यग्रजन्मनः॥पितापितामहोभ्राता"
        },
        {
          "id": "line_6",
          "box_2d": [
            330,
            120,
            415,
            885
          ],
          "text": "सकुलो जननी तथा॥कन्याप्रदः पूर्वनाशे प्रकृतीस्थःपरःपरः॥अप्रयच्छन् समाप्नोतिभ्रूणहत्यामृता"
        },
        {
          "id": "line_7",
          "box_2d": [
            405,
            120,
            485,
            885
          ],
          "text": "वतौ॥गम्यंत्वभावेदातॄणां कन्याकुर्यात्स्वयंवरं॥सकृत्प्रदीयते कन्या हरंस्तांचौरदंडभाक्॥दत्ता"
        },
        {
          "id": "line_8",
          "box_2d": [
            475,
            25,
            545,
            115
          ],
          "text": "पूर्वोक्तैराः"
        },
        {
          "id": "line_9",
          "box_2d": [
            480,
            120,
            560,
            885
          ],
          "text": "मपिहरेत्पूर्वाच्छ्रेयांचेद्वरआव्रजेत्॥अनाख्याय ददद्दोषं दंड्य उत्तमसाहसं॥अदुष्टांचत्यजन्दंड्य"
        },
        {
          "id": "line_10",
          "box_2d": [
            565,
            15,
            625,
            120
          ],
          "text": "पुनःसंस्कारदूषता"
        },
        {
          "id": "line_11",
          "box_2d": [
            555,
            120,
            635,
            885
          ],
          "text": "जोदूषयन् शतं॥अक्षता च क्षता चैव पुनर्भूः संस्कृता पुनः॥स्वैरिणी या पतिं हित्वा सवर्णं काम"
        },
        {
          "id": "line_12",
          "box_2d": [
            630,
            20,
            690,
            95
          ],
          "text": "नरजाई २"
        },
        {
          "id": "line_13",
          "box_2d": [
            630,
            120,
            710,
            885
          ],
          "text": "तःश्रयेत्॥अपुत्रां गुर्व्नुज्ञातो देवरः पुत्रकाम्यया॥सपिंडो वा सगोत्रो वा घृताभ्यक्तस्त्वियात्"
        },
        {
          "id": "line_14",
          "box_2d": [
            655,
            895,
            710,
            950
          ],
          "text": "राम ५"
        },
        {
          "id": "line_15",
          "box_2d": [
            800,
            350,
            875,
            595
          ],
          "text": "संस्काराच्चागेव पूर्व संबंधविचार"
        }
      ]
