      "lines": [
        {
          "id": "line_0",
          "box_2d": [
            205,
            125,
            280,
            873
          ],
          "text": "॥विजिज्ञासायान्वासनं स्वादु भोजनं सूनृतं वचः॥ प्रतिसंवत्सरं पूज्याः स्नातक आचार्यपार्थिवाः॥ प्रिय"
        },
        {
          "id": "line_1",
          "box_2d": [
            265,
            125,
            345,
            873
          ],
          "text": "प्रियो विवाह्यश्च तथा यष्टव्यः सर्तितः पुनः॥ अधनी नो तिथिर्ज्ञेयो श्रोत्रियो वेदपारगः॥ मान्या वै तौ गृह"
        },
        {
          "id": "line_2",
          "box_2d": [
            330,
            125,
            410,
            873
          ],
          "text": "हस्थस्य ब्रह्मलोक महीयतः॥ परपाकरुचिर्न स्यादनिंद्या मंत्रणाहते॥ वाक्यदिपोराचापत्वं व"
        },
        {
          "id": "line_3",
          "box_2d": [
            395,
            125,
            480,
            873
          ],
          "text": "र्जयेज्ज्ञातिभोजनं॥ अतिथिं श्रोत्रियं त्प्रमासीमंतादनुव्रजेत्॥ अहं को वंसहासी तद्विधैरेव है"
        },
        {
          "id": "line_4",
          "box_2d": [
            465,
            125,
            545,
            873
          ],
          "text": "सह भुजिः॥ उपास्य पश्चिमां संध्यां हुत्वाग्नींस्तान्युपास्य च॥ न तैः परिभवेज्जुक्तानातिवृत्तान् सं"
        },
        {
          "id": "line_5",
          "box_2d": [
            535,
            125,
            615,
            873
          ],
          "text": "विशेत॥ ब्राह्मे मुहूर्त्ते चोत्थाय चिंतयेदात्मनो हितं॥ धर्मार्थकामान्स्वे काले यथाशक्ति"
        },
        {
          "id": "line_6",
          "box_2d": [
            605,
            125,
            685,
            873
          ],
          "text": "र्न हापयेत्॥ विद्याकर्मवयोबंधुवित्तैर्मान्या यथाक्रमं॥ एतैः प्रनूतैः शूद्रोपि वार्द्धके मानमर्ह"
        },
        {
          "id": "line_7",
          "box_2d": [
            675,
            125,
            755,
            873
          ],
          "text": "ति॥ वरं मार्गं न पश्नात्स्त्रीरोग वरचक्रिणां॥ पंथा देयो नृपस्यैषा मान्या स्नातकभूपतेः॥ इज्या"
        }
      ]
    },
