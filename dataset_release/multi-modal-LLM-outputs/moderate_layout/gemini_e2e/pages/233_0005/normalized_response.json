      "lines": [
        {
          "id": "line_0",
          "box_2d": [
            230,
            134,
            325,
            875
          ],
          "text": "स्नानमब्दैवतैर्मन्त्रैर्मार्जनं प्राणसंयमः ॥ सूर्यस्याचाप्युपस्थानं गायत्र्या प्रत्यहं जपः ॥ गायत्री"
        },
        {
          "id": "line_1",
          "box_2d": [
            295,
            134,
            390,
            875
          ],
          "text": "शिरसार्द्धं जपेद्व्याहृतिपूर्विकां ॥ प्रतिप्रणवसंयुक्तां त्रिरयं प्राणसंयमः ॥ प्राणायामप्रसंयोगे व्यस्य"
        },
        {
          "id": "line_2",
          "box_2d": [
            365,
            134,
            475,
            885
          ],
          "text": "चेनावदैवतेन तु ॥ जपन्नासीत सावित्रीं प्रसंगातारकोदयात् ॥ संध्यां प्राक् प्रातरेवं हि तिष्ठेदासूर्यदर्श"
        },
        {
          "id": "line_3",
          "box_2d": [
            445,
            134,
            555,
            885
          ],
          "text": "नात् ॥ अङ्किकां चैततः कुर्यात्संध्योरुभयोरपि ॥ ततोभिवादयेद्वृद्धानसावहमिति ब्रुवन् ॥ गु"
        },
        {
          "id": "line_4",
          "box_2d": [
            525,
            134,
            635,
            885
          ],
          "text": "रुं चैवाप्युपासीत संध्यायाश्च समाहितः ॥ आहूतश्चाप्यधीयीत लब्धं चास्मै निवेदयेत् ॥ हितं चास्या"
        },
        {
          "id": "line_5",
          "box_2d": [
            595,
            134,
            710,
            885
          ],
          "text": "चरेन्नित्यं मनोवाक्कायकर्मभिः ॥ कृतज्ञो द्रोहि मेधावि शुचिकल्याणासूयकाः ॥ अध्याप्या धर्म्मि"
        },
        {
          "id": "line_6",
          "box_2d": [
            675,
            134,
            785,
            885
          ],
          "text": "तः साधुशक्ताः प्रज्ञानवित्तदाः ॥ दंडं जिनोपवीतानि मेखलां चैव धारयेत् ॥ ब्राह्मणेषु चरेद्भैक्षं"
        }
      ]
    },
