			<TextLine id="line_6">
				<Coords points="335,759 2212,759 2212,653 335,653" />
				<TextEquiv>
					<Unicode>तः साधुशक्ताः प्रज्ञानवित्तदाः ॥ दंडं जिनोपवीतानि मेखलां चैव धारयेत् ॥ ब्राह्मणेषु चरेद्भैक्षं</Unicode>
				</TextEquiv>
			</TextLine>
