{
  "text": {
    "0": "॥ अमावस्याष्टमीचैव पूर्णिमा च चतुर्दशी। ब्रह्मचारी भवेन्नित्यं तत्र स्नातो द्विजः ॥ २ =",
    "1": "12",
    "2": "M-233",
    "3": "स्पंदितव्यः प्राप्तिः प्रोपुत्रपौत्रप्रपौत्रकैः ॥ यस्मात्तस्मात्त्रियः सेव्या कर्तव्याश्च सुरक्षिताः ॥ षोडशर्तु निशा",
    "4": "याज्ञव० ६",
    "23": "तैः",
    "5": "स्त्रीणां तस्मिन् युग्मासु संविशेत् ॥ युग्मासु पुत्रा जायंते स्त्रियोऽयुग्मासु रात्रिषु ॥ ब्रह्मचर्येव पर्वा",
    "6": "सनुका लदिनप्र",
    "7": "ण्याद्यास्तस्त्रश्च वर्जयेत् ॥ ऋतौ तु नैर्गर्भसंकिलात् स्नानं मैथुनिनः स्मृता ॥ अनृतौ तु सदा कार्यशौ",
    "8": "तपः चकारः ३ =",
    "9": "चमूत्रपुरीषवता ॥ एवं गच्छन् स्त्रियं क्षामां मघा मूलं च वर्जयेत् ॥ सुस्थेंदौ सकलपुत्रलक्षण संजनी",
    "10": "येत्पुमान् ॥ यथाकामी भवेद्वापि स्त्रीणां वरमनुस्मरन् ॥ स्वदारनिरतश्चैव स्त्रियो रक्ष्या यतः स्मृ",
    "11": "स्वरुपाननेवे",
    "13": "पाता३ =",
    "12": "ताः ॥ भर्त्तृभ्रातृपितृज्ञातिश्वश्रूश्वशुरदेवरैः ॥ बंधुभिश्च स्त्रियः पूज्या भूषणच्छादनाशनैः ॥ संय",
    "14": "सदैव प्रहसिता",
    "16": "उपस्करोगहोपकर",
    "15": "तोपस्करा दक्षा हृष्टा व्ययपराङ्मुखी ॥ कुर्याच्छ्वशुरयोः पादवंदनं भर्त्तृतत्परा ॥ क्रीडां शरी",
    "17": "णवर्मेवचायचोन्मुख",
    "19": "राम ६",
    "20": "लमुशलसूफीरेः २ =",
    "18": "रसंस्कारं महोत्सवदर्शनं ॥ हास्यं परगृहे यानं त्यजेत्प्रोषितभर्त्तृका ॥ रक्षेत्कन्यां पिता वि",
    "21": "त्रै",
    "22": "नो२"
  },
