{
  "text": {
    "0": "द्रव्यदानातृहारहसिदंतस्यो संयेगस्मानतगंधर्वः १=",
    "1": "M-233",
    "2": "10",
    "3": "याज्ञव० ५=",
    "4": "रौद्रवैशादानात्गंधर्वः समयान्मिथः ॥ राक्षसो युद्धहरणा पैशाचः कन्यकाछलात् ॥ काणो ग्राह्यः",
    "5": "शूद्र",
    "6": "सवर्णासुगृहीयात्क्षत्रियाशरं ॥ वैश्यांशूद्रोतोदमाद्द्यादैवेनेत्यग्रजन्मनः ॥ पिता पितामहो भ्राता",
    "7": "पिता",
    "8": "सकुलो जननी तथा ॥ कन्याप्रदः पूर्वनाशे प्रकृतीस्थः परः परः ॥ अप्रयच्छन्त्समाप्नोति भ्रूणहत्यामृता",
    "9": "वतौ ॥ गम्यं त्वभावे दातॄणां कन्या कुर्यात्स्वयंवरं ॥ सकृत्प्रदीयते कन्या हरंस्तां चौरदंडभाक् ॥ दत्ता",
    "10": "चैवान्याश्चेन्न",
    "11": "मपिहरेत्पूर्वाच्छ्रेयांसं वरमाव्रजेत् ॥ अनृतं तु वदन्दंड्य उत्तमसाहसं ॥ सदुष्टां च त्यजन्दंड्य",
    "12": "पूर्वोक्तरीत्या",
    "13": "अक्षतवपु",
    "14": "जो दूषयंस्त्वमृषाशता ॥ अक्षता च क्षता चैव पुनर्भूसंस्कृता पुनः ॥ स्वैरिणी या पतिं हित्वा सवर्णं काम",
    "15": "पुनःसंस्कारदेवता",
    "20": "२",
    "16": "तः श्रयेत् ॥ अपुत्रां गुर्व्नुज्ञातो देवरः पुत्रकाम्यया ॥ सपिंडो वा सगोत्रो वा घृताभ्यक्तस्त्वियात्",
    "17": "तरजाई २",
    "18": "राम ५",
    "19": "संस्काराश्चैव पूरुष संबंधविचार"
  },
