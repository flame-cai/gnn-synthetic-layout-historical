{
  "text": {
    "0": "नमोपरशास्त्रीविधनाम्नाकत्तव्याकृतेनम्ना=",
    "1": "पुरुषंतरसंयोगकल्पतरौ२",
    "2": "ना८",
    "3": "M-233",
    "4": "भिर",
    "5": "॥",
    "6": "आगर्भसंभवाऊढे ततितस्तन्प्यानवेत्॥अनेनविधिनाजातक्षेत्रजोप्यनवेत्सुतः॥हताधिकारामति",
    "7": "परक्रेतुः२",
    "8": "नापिंडमात्रोपजीविनी॥परिनूतामद्यःशष्यावासयेद्यभिचारिणी॥सोमःशौचंददौस्त्रीणांगंधर्वश्चप्रयु",
    "9": "क्तांजिरं॥पावकःसर्वमेध्यत्वंमेध्यावैयोषितोहतः॥व्यभिचारादृतौशुद्धिर्गर्भत्वागोविचीयते॥गर्जं",
    "10": "नैवधादौचतयामहतिपातके॥सुरापीव्याधितायूत्तीवंध्यर्थघ्नीप्रियंवदा॥स्त्रीप्रसूश्चाधिवेतव्या",
    "11": "त्तृ",
    "12": "ता४",
    "13": "पुरुषद्देषिणीतथा॥अधिविन्नाविकर्त्तव्यामहदेनेन्यथानवेत्॥यत्रानुकूल्यंदंपत्योस्त्रिवर्गः",
    "14": "सत्रवर्द्धते॥मतेजीवतिवापत्यौयानान्यमुपगच्छति॥सेहकीर्त्तिमवाप्नोतिमोदतेचोमयास",
    "15": "पुत्रवंती२",
    "16": "ह॥प्रात्तासंपादिनीदक्षावीरसूःप्रियवादिनी॥सजूरदाप्यस्तृतीयाशमद्वयोर्नरस्त्रियां॥स्त्री",
    "17": "भिर्त्तुवच्चकार्य्यमेषःधर्मःपरस्त्रियाः॥आयुःसंप्रतीस्योहिमहापातकदूषितः॥लोकानं"
  },
