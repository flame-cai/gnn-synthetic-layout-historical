{
  "text": {
    "0": "त २",
    "1": "M-233",
    "2": "16",
    "25": "३",
    "3": "बत्रौ",
    "4": "॥ निजविवायान्वासनस्वादुभोजनसूनृतवचः॥ प्रतिसंवत्सरं पूज्याः स्नातकाचार्यपार्थिवाः॥",
    "5": "गुरोसत्तयावेदपू",
    "6": "याज्ञ २",
    "7": "जास्नातकः ब्रह्म",
    "8": "योविवाहव्रतपायज्ञप्रसङ्गिनः पुनः॥ अधनीनोतिथिज्ञेयो श्रियोवेदपारगः॥ मान्यावैतौगृ",
    "9": "वरः",
    "10": "चारी २=",
    "11": "हस्थस्य ब्रह्मलोकमभीप्सतः॥ परपाकरुचिर्नस्यादनिंद्या मंत्रणादृते॥ वाक्पादपाणिचापलं व",
    "12": "र्जयेज्ज्ञातिभोजनं॥ अतिथिं श्रोत्रियंत्वप्रमासीमंतादनुव्रजेत्॥ अहंहोवंशहासीतदिक्षैरैरे",
    "13": "क्षितैइतिहासपु",
    "14": "राणवेदविः ४",
    "15": "प्रवद्युभिः॥ उपास्यपश्चिमां संध्यां हुताग्नींस्तनुपास्य च॥ न संपरिणतो भुक्तानाति तृप्ता सं",
    "16": "इत्येका यकया",
    "17": "प्रपंचभिः ४=",
    "18": "विशेत्॥ ब्राह्मेमुहूर्ते चोत्थाय चिंतयेदात्मनो हितं॥ धर्मार्थकामान्स्वे काले यथाशक्ति",
    "19": "र्नहापयेत्॥ विद्याकर्मवयोबंधुवित्तैर्मान्या यथाक्रमं॥ एतैः प्रभूतैः शूद्रोपि वार्द्धके मानमर्ह",
    "26": "मैत्र कः",
    "20": "नारदकां ११",
    "21": "ति॥ वरुनारिनपस्नातस्त्रीरोगवरचक्रिणां॥ पंथादेयो नृपस्तेषां मान्या स्नातश्च भूपतेः॥ इज्या",
    "22": "रामच",
    "23": "२",
    "24": "२३३"
  },
