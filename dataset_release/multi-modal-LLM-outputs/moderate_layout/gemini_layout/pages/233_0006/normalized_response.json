{
  "text": {
    "0": "किंवा चूडाकर्म ५",
    "1": "ब्रह्मचारीधर्मः ५",
    "2": "M-233",
    "3": "a",
    "4": "6",
    "5": "याज्ञव० ३",
    "6": "मन्त्रेष्वप्येष नियमोऽदिमध्यावसानेषु न वै वेदोपलक्षिता॥ ब्राह्मराजन्यविशां भैक्षचर्या यथा",
    "7": "क्रमं॥ कृताग्निकार्यो भुञ्जीत वाग्यतो गुर्व्वनुज्ञया॥ आपोशानक्रियापूर्व्वं सत्कृत्यान्नमकुत्सय",
    "8": "न्॥ ब्रह्मचर्ये स्थितो नैकमन्नमद्यादनापदि॥ ब्राह्मणः काममश्नीयात् श्राद्धे व्रत मपीडयन्॥ अभ",
    "9": "तै",
    "10": "वेहा० प्र० ४",
    "11": "द्युमांसं जनोच्छिष्टं सूक्तस्त्रीप्राणिहिंसनं॥ भास्करालेकनाश्लीलपरिवादादिवर्जयेत्॥ सः गुरुर्यः",
    "12": "प्रसन्नभास्करा ४",
    "13": "गायत्रीव्यतिरिक्तं",
    "14": "क्रियाकृत्वा वेदमस्मै प्रयच्छति॥ उपनीय ददेद्वेदमाचार्य्यः स उदाहृतः॥ एकदेशमुपाध्यायस्तद्विज्यत",
    "15": "कदुच्यते॥ एतेमान्या यथापूर्व्वमेभ्यो माता गरीयसी॥ प्रतिवेदं ब्रह्मचर्य्यं द्वादशाब्दानि पञ्च",
    "16": "वा॥ ग्रहणान्तिकमित्यन्ये केशान्तश्चैव षोडशे॥ आषोडशादाद्वाविंशाच्चतुर्विंशाच्चवत्स",
    "17": "पारस्करगृह्यसूत्रं १२",
    "18": "राम ३",
    "19": "गायत्री ३",
    "20": "एकदेशं तु वेदस्य वेदाङ्गान्यपि वा पुनः॥",
    "21": "योऽध्यापयति वृत्त्यर्थमुपाध्यायः स उच्यते॥",
    "22": "चै"
  },
