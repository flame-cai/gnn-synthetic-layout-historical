{
  "text": {
    "0": "॥ मृतायां तु द्वितीयां तु यो भार्यामुद्वहेत् द्विजः। वह्न्यर्धतंत्विजानी",
    "1": "द्वितीयांचैव यो भार्या दहेदग्निभिरुन्मदैः। जीवंत्यांप्रथमायां तु सुरापनसमं हितं॥४॥",
    "2": "यादध्र्यकामन्समुत्सृजता॥४॥",
    "3": "ब्राह्मणेन क्षत्रियायां उत्पादितः क्षत्रियः एव क्षत्रियेण वैश्यायां उत्पादितः वैश्यः एव वैश्येन शूद्रायां उत्पादतः शूद्रः एव ॥६॥",
    "4": "13",
    "5": "M-233",
    "21": "व व",
    "6": "शास्त्रोक्त विधिना",
    "7": "नोत्पत्तिः पुत्राणां वार्द्धके॥ मृजावेतातपस्तेषां स्वातंत्यं न कविद स्त्रियः॥ पितृमातृसुतभ्रातृश्व",
    "8": "विवाहता स्त्री १२",
    "9": "शूश्वशुरमातुलैः॥ हीना न स्यादिना नर्त्तव्य गृहणी यान्यथा भवेत्॥ पतिप्रियहिते युक्ता स्वाचा",
    "10": "रा विजितेंद्रया॥ सेह कीर्त्तिमवाप्नोति प्रेत्य चानुत्तमां गतिं॥ सत्यामन्यां सवर्णायां धर्म्मकार्यं",
    "22": "न",
    "11": "द्वेयोक्तव्याः ४",
    "12": "ए ४",
    "13": "न कारयेत्॥ सवर्णासु विधौ धर्म्मे ज्येष्ठयान विनेतराः॥ दाहयित्वाग्निहोत्रेण स्त्रियं वृत्तवतीं पतिः",
    "14": "आहरेद्विधिवद्दारानग्नींश्चैवाविलंबयन्॥ इति विवाह प्रकरणं॥ सवर्णेभ्यः सवर्णासु जायते",
    "15": "हि सजातियः॥ अनिंदितेषु विवाहेषु पुत्राः संतानवर्द्धनाः॥ विप्राद्रमूर्द्धावसिक्तो हि क्षत्रियायां विशः स्त्रिया",
    "16": "यां॥ अंबष्ठः शूद्र्यां निषादो जातः पारशवो पि वा॥ वैश्या शूद्र्योस्तु राजन्यान्माहिष्योग्रौ सुतौ स्मृतौ",
    "17": "शास्त्रोक्त विवाह",
    "18": "॥ वैश्यात्तु करणाच्छूद्र्यां विन्नास्वेष विधिः स्मृतः॥ ब्राह्मण्यं क्षत्रियात्सूतो वैश्याद्वैदेहिकस्तथा",
    "19": "तास्तु २",
    "20": "प्रमीतनां पीपुत्राह पूर्वैः को वत्तवती गुरुवती श्रोत्रग्निना दहिति मातदनावेन स्नातेना॥४॥ शीघ्रमेव मृताष्यामीनतीरेनुद्दनमेकमपि द्विजः ४"
  },
