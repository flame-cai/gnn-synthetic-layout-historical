			<TextLine id="line_1">
				<Coords points="325,237 2462,235 2462,199 325,201" />
				<TextEquiv>
					<Unicode>रांचनारौंशश्ची श्रीगापिकाः॥ इति हास्संस्तपाविद्याः शक्राधीतेति चोन्वहम्॥ मांसच्चीरोदनमधुतर्पणंस</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="75,279 2462,277 2462,239 75,241" />
			<TextLine id="line_2">
				<Coords points="75,279 2462,277 2462,239 75,241" />
				<TextEquiv>
					<Unicode>दिवैकसा॥ करोतितप्तिं कुर्यान्नपितॄं मध्वच्चयुसंविधा॥ तैत्रास्सर्पयंत्येनं सर्वकामफलैःशुभैः॥ यं यं ते देवाःपितरः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="75,319 2462,317 2462,279 75,281" />
			<TextLine id="line_3">
				<Coords points="75,319 2462,317 2462,279 75,281" />
				<TextEquiv>
					<Unicode>क्रतुमधीयीत तस्पतस्यानुयात्कलं॥ त्रिर्वापि पूर्णपृथिवीदानस्य फलमश्नुते॥ तपसाच्च परस्पेह</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="75,359 2462,357 2462,319 75,321" />
			<TextLine id="line_4">
				<Coords points="75,359 2462,357 2462,319 75,321" />
				<TextEquiv>
					<Unicode>नित्यंस्वाध्यायवाचरेद्विजः॥ नैष्ठिको ब्रह्मचारीतु वसेदाचार्यसन्निधौ॥ तदभावेऽस्पत्नयेपन्यावैद्या</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="75,399 2462,397 2462,359 75,361" />
			<TextLine id="line_5">
				<Coords points="75,399 2462,397 2462,359 75,361" />
				<TextEquiv>
					<Unicode>नरेऽपि वा॥ अनेनविधिना देवान्नसाधयन् विजितेन्द्रियः॥ ब्रह्मलोकमवाप्नोतिनचेहाजायते पुनः॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="75,438 2462,437 2462,399 75,400" />
			<TextLine id="line_6">
				<Coords points="75,438 2462,437 2462,399 75,400" />
				<TextEquiv>
					<Unicode>इति ब्रह्मचारिप्रकरणम्॥ गुरुवैतुवरं दत्वास्नात्वेत्तदनुज्ञया॥ वेदव्रतानिवापारंनीत्वाभुज्</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="75,478 1750,476 1750,438 75,440" />
			<TextLine id="line_7">
				<Coords points="75,478 1750,476 1750,438 75,440" />
				<TextEquiv>
					<Unicode>यमेवावा॥ अवभृत्ब्रह्मचैलंतत्संसृज्यच्छयत्तह्रदे॥ अनन्तपद्विकाकांतामसंपिंडान्वियच्छी॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
