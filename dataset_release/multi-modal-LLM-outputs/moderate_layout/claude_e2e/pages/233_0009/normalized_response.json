      "lines": [
        {
          "id": "line_header",
          "box_2d": [
            15,
            320,
            45,
            995
          ],
          "text": "२ महुहकुता नाहरतव्या ऽऽत्तः मात्तः वसुः शारऽ पंचमतः उर्ध्द पित्तः पित्तवसुः शारऽ सप्तमतः उर्ध्द १२"
        },
        {
          "id": "line_label_M233",
          "box_2d": [
            95,
            30,
            150,
            150
          ],
          "text": "M-233"
        },
        {
          "id": "line_label_9",
          "box_2d": [
            90,
            930,
            140,
            975
          ],
          "text": "९"
        },
        {
          "id": "line_label_tar",
          "box_2d": [
            140,
            935,
            175,
            985
          ],
          "text": "तार"
        },
        {
          "id": "line_jam",
          "box_2d": [
            170,
            350,
            215,
            395
          ],
          "text": "जां"
        },
        {
          "id": "line_1",
          "box_2d": [
            215,
            60,
            265,
            995
          ],
          "text": "मरोगसंतानतमतीमसमानगोत्रयोः पंचमात्प्रमादूर्ध्वं मातृतः पितृतस्तस्य। दशपुरुषाद्भवेत्तत्र"
        },
        {
          "id": "line_2",
          "box_2d": [
            275,
            55,
            325,
            995
          ],
          "text": "क्षोत्रियां महाकुलात्रास्थीतादपिसंचारीरोगदोषसमन्वितात्। एतैरेवगुणैर्युक्तः सर्वशिष्यो"
        },
        {
          "id": "line_3",
          "box_2d": [
            335,
            60,
            390,
            995
          ],
          "text": "श्रीयावरः॥ यज्ञोपवीतीयेत्रुस्त्रीयुवाधीमान् जनप्रियः॥ यदुच्यते द्विजातीनां शूद्रात्रोपसंग्रह"
        },
        {
          "id": "line_4",
          "box_2d": [
            400,
            55,
            455,
            995
          ],
          "text": "ह॥ नैतन्मम मतव्यस्तात्रात्मानापयतेस्वयं॥ पितरोऽरक्षिनैर्वाहा देत यैकाप्येताजनम्॥ ज्ञानय"
        },
        {
          "id": "line_4_annot",
          "box_2d": [
            385,
            375,
            410,
            430
          ],
          "text": "मोता"
        },
        {
          "id": "line_5",
          "box_2d": [
            460,
            55,
            515,
            995
          ],
          "text": "त्रिय विद्यां ज्ञायाश्रयूद्रजन्मनः॥ वाहोतिवाह्रा अत्रयदी यते पात्रं वृंदात। तत्र पुनात्रुत्रापतः"
        },
        {
          "id": "line_5_annot",
          "box_2d": [
            445,
            455,
            470,
            540
          ],
          "text": "रेरैनवाहे"
        },
        {
          "id": "line_6",
          "box_2d": [
            525,
            45,
            580,
            995
          ],
          "text": "पुरुषाणेकविंशति॥ यत्रास्त्यस्ति द्विजैदैवं ब्राह्यो यां वस्तगोत्रवं॥ चतुर्द्विषच्रयमतः पुनात्रुत्तरजाश्रव"
        },
        {
          "id": "line_6_annot",
          "box_2d": [
            510,
            510,
            540,
            595
          ],
          "text": "अष्टविवाह"
        },
        {
          "id": "line_7",
          "box_2d": [
            590,
            45,
            645,
            995
          ],
          "text": "षट्॥ इत्युक्तचरतां धर्मंसंहितादीयतैस्तिने॥ सकांपःपावयेतल्लः षट्षट् पंचान्यान्महात्मना"
        },
        {
          "id": "line_7_annot_top",
          "box_2d": [
            575,
            555,
            600,
            635
          ],
          "text": "श्राऽपत्यः"
        },
        {
          "id": "line_7_left_margin",
          "box_2d": [
            605,
            10,
            635,
            90
          ],
          "text": "अनपत्यः"
        },
        {
          "id": "line_8",
          "box_2d": [
            655,
            45,
            710,
            995
          ],
          "text": "प्रास्तवरीषोपायतारदेनोपचर्षितः। यस्यापक्षुप्रवते वीर्यं हादसूत्रंचकैनल। पुत्रास्तान्दिहौरैत्रैषपरितैस्तचंडक॥ ५॥"
        },
        {
          "id": "line_8_left_margin",
          "box_2d": [
            660,
            10,
            690,
            95
          ],
          "text": "अन्यपसह"
        },
        {
          "id": "line_pagenum",
          "box_2d": [
            810,
