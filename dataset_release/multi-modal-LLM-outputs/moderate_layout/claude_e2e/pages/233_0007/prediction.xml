				<TextEquiv>
					<Unicode>रात्रौ ब्रह्मत्रियविशां कालज्ञैपनायज्ञिकः परः॥छतः उर्ध्वयत्नस्तेत्संवैधर्मंवहिष्ठता॥साद्वि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="270,268 2250,268 2250,241 270,241" />
			<TextLine id="line_2">
				<Coords points="270,268 2250,268 2250,241 270,241" />
				<TextEquiv>
					<Unicode>पतितावात्पव्याप्तेभ्राह्तेकीतो मानुर्ष्ट्रेजाय द्वितीयंमैत्रिवंचनात्॥व्राह्राणत्रियविश</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="270,314 2250,314 2250,287 270,287" />
			<TextLine id="line_3">
				<Coords points="270,314 2250,314 2250,287 270,287" />
				<TextEquiv>
					<Unicode>स्समादेते द्विजाःस्रता॥ पद्यानातपसाचैवज्ञानाचैवकर्मणा॥वेदद्वैएवद्विजातीनांस्त्रे</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="270,361 2225,361 2225,334 270,334" />
			<TextLine id="line_4">
				<Coords points="270,361 2225,361 2225,334 270,334" />
				<TextEquiv>
					<Unicode>यसकरः परः॥ मधुनापयसाचैवसदेवाःसर्पिचेद्दिजः॥पिट्टदधिघृतान्नाच्यचोधीतेनुयोन्व</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
