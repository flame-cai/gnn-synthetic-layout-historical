			<TextLine id="line_0">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>वकादिमन्वा = नारासंगीः रुद्रदेवत्यामंत्रान्॥१=यज्ञगाथें उणायाद्या१=इति हासामहानारतादीनविद्याश्चकारणाद्यै।१=</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_1">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>दिधर्मशास्त्रार्थ</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_2">
				<Coords points="" />
				<Baseline points="" />
