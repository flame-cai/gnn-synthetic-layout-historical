				</TextEquiv>
			</TextLine>
			<TextLine id="line_4">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>सनिहवे। यान्वासनस्वाभोजनं सूनंतंवचः॥ प्रतिसंवत्सरलपौष्पीः स्नातकाचार्यपार्थिवाः</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_5">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>येविवात्यश्चतथा यज्ञां संततिः पुनः॥अधनीनोतिचिर्येयोःश्रोत्रियोवेदपारगः॥मान्यावैतैएग</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_6">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>हस्यस्पवत्मलोकमभीमतः॥परपाकरुचिर्नस्पादनेघामंत्रणाहते॥वाक्यादिपासाचापत्यंव</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_7">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>र्जयेच्छातिभोजनं॥प्रतिथिस्त्रोत्रियंतप्रमासीमताइन्द्रजेर॥अहंशेषंसहासीतधिदैवेहै</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_8">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>श्रवद्युक्तिः॥उपास्यपश्चिमासंध्याहुत्वाग्नीस्तानुयास्पच॥जलेपरमतोमुक्तानातिव्या-सं</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_9">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>विशेता॥बाह्मेमुहूर्तेचोत्यापचितपेदात्मनोहितं॥धमीर्थकामान्स्वेकालेपयामाशक्तिः</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_10">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>नहापयेत॥विद्याकर्मवयोवंधुवितैर्मन्यायथाक्रमं॥एतैःप्रमूतैःयूडोपिवाईकेमानमह</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_11">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>ति॥वद्धनारिनपस्नातस्त्रीरोगवरचक्रिणं॥पंथादेपोन्नपलेवामान्यास्तथ्यनूपतेः॥इज्या</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_12">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>युरोराजपावेदपू</Unicode>
				</TextEquiv>
