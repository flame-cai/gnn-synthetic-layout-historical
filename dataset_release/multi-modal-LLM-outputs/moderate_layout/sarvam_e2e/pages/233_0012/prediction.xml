			<TextLine id="line_5">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>त्यंदिवःप्राप्तिःप्रपुत्रपौत्रप्रपौत्रकैः॥ यस्मात्तत्सास्त्रियःसेव्याकर्त्तव्याश्चसुरक्षिताः॥षोडशार्जुनेशा</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_6">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>स्त्रीणां तैर्मन्त्रयुग्मासुसंविशेत्॥युग्मासुपुत्राजायंतेस्त्रियोयुग्मासुरात्रिषु॥ब्रह्मचार्येवपर्वा</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_7">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>न्यायाश्चतस्र्यवर्जयेत्॥ततोतुर्कगर्भसंकिलातरस्नानमैथुनिनःस्मृताः॥अन्यतौतुसहाकार्ययोः</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_8">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>चमूत्रपुरीषवतः॥एवंगच्छन्स्त्रियंज्ञामामघामूलचवर्जयेत्॥सुस्पैंगैसरुपुत्रलक्षणान्यजनना</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_9">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>चेत्सुमान्॥यथाकर्मनवेदापिस्त्रीणांवरमनुस्मरन्॥स्वदारनरनैतश्चैवस्त्रियोरक्षायतःसृष्ट</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_10">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
