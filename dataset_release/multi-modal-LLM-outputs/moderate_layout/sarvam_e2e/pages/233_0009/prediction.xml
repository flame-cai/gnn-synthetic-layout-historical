			</TextLine>
			<TextLine id="line_4">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>तार</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_5">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>नमामि</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_6">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>मुरो गिरीजात मतीमसमानर्वगोत्रयो॥ पंचमासप्रभा इर्से मात्तःपित्तस्तथा॥ द्वापुरु पविख्याति</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_7">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>श्रोत्रियाराणा महाकुलाशास्फीतादपिनसंचारीरोगदोपसमन्वितया॥ एतैरेवगुह्यैर्युक्तः सवर्णियो</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_8">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>श्रयोवरः॥ यन्नात्यरीक्षमैतःपुंस्नेयुवाधीमान्जनप्रियः॥यदुच्यतेऽज्ञातीनां शूद्रात्तरोपसंग्र</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_9">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>हः॥नैतन्मममतयस्मात्तत्रामाजापतेस्वयं॥ ततोऽनपूर्वेण द्वेतथैकापयाक्रमं॥ब्राह्मण</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_10">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>क्षत्रियविशांजायाश्चमूइजन्मनः॥ वास्तेविवाहआरूयदीयतेष्वलंकृता॥तज्रःपुनात्युनयतः</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_11">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>पुरुषानेकविंशति॥यज्ञस्पष्टविजेदैवआर्वीर्यस्तगोद्वये॥चतुर्दशायत्रयमजःपुनात्युत्तररजश्रव</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_12">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>ह॥इत्युक्तचरतांधर्मसहपादीयतेऽपने॥सकायःपावयेतजःषट्पर्वेश्यानमाहात्म्यम्॥ज्यासु</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_13">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>=परीक्षोपायनारदेनोपदर्शितः॥यस्मात्प्रभृतयेवीर्यहारमूत्रकेनलं॥पुमांस्वालक्ष्मेरैनैवपिरीतैस्तकषटकं॥५८॥-</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_14">
