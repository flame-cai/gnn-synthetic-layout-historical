				</TextEquiv>
			</TextLine>
			<TextLine id="line_1">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>पञ्चामातिशयर</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_2">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>स्नानमदैवौर्मत्रैर्मीजनप्राणसंयमः॥ सूर्यस्याचाप्युपस्थानंगायव्याप्रत्यहंजपः॥गायत्री।</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_3">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>शिरसार्द्धेन वेद्याहतिपूर्विकां॥प्रतिप्रणवसंयुक्तैरयंत्राणसंयमः॥प्राणानापम्पसंप्रोष्यल</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_4">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>चेनादैवतेनतु॥जपन्नासीतसावित्रीप्रसंगातारकोदयात॥संध्याप्राक्तप्रातरेवहितेदासूर्यदर्श</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_5">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>नाता॥अर्जुनकाञ्चिततःकुर्यात्संस्थयोर्नयोरपि॥ततोऽविवादयेद्ददानसावरमितिब्रुवन्॥गु</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_6">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>रुंचैवाप्नुपासीतध्यापार्थसमाहितः॥आहुस्तथाप्पधीयीतलघंचासैवेदेत्येत॥हितंचात्या</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_7">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>चरेन्नित्यंमनोवाक्यकर्मनिः॥कृतज्ञाप्रेहिमेधाविशुचिकल्पारासूपकाः॥अध्याप्याधर्मा</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_8">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>तःसाधुशक्ताप्रज्ञानवित्तदाः॥एंडाजेनोपवीतानिमेलखाचैवधारयेत्॥ब्राह्मणेषुचरेद्वैत्त</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_9">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>मार्तंड बार</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_10">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>पूर्वनिमुखः</Unicode>
				</TextEquiv>
			</TextLine>
