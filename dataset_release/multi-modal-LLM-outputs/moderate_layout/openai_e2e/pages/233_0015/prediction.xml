			<TextLine id="line_0">
				<Coords points="315,251 2192,245 2188,201 318,206" />
				<TextEquiv>
					<Unicode>वैदिकर्मविधौमस्याध्यापनिध्याख्याः श्रोतव्यमेव सर्वकर्मप्रधाना धर्माः कार्या इत्येव</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="315,308 2192,300 2195,256 318,264" />
			<TextLine id="line_1">
				<Coords points="315,308 2192,300 2195,256 318,264" />
				<TextEquiv>
					<Unicode>त्रेपुद्दतादेकान्देधात्रुतवविचरेद् । शुद्धकर्मणोऽवचारणवापसेन विधिवत् प्रेत्यवित्क्रमे</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="308,367 2195,360 2188,315 315,322" />
			<TextLine id="line_2">
				<Coords points="308,367 2195,360 2188,315 315,322" />
				<TextEquiv>
					<Unicode>चोदयेन्नमस्कृतं जेताऽसौ ह्रदायैवाम्बरे किं च वेदेन कर्मणे लालस्ख्यातिनोऽत्राग्निरपि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="310,430 2195,422 2192,375 310,385" />
			<TextLine id="line_3">
				<Coords points="310,430 2195,422 2192,375 310,385" />
				<TextEquiv>
					<Unicode>तुरेणेच्छका । निनोऽग्नाविधिः समग्रेण पत्रीरेखनो जनाः । प्राश्नाप्रलेखोऽवचिन्त्य जीतो नरः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="310,491 2185,483 2188,436 310,445" />
			<TextLine id="line_4">
				<Coords points="310,491 2185,483 2188,436 310,445" />
				<TextEquiv>
					<Unicode>आपेह । प्रीतो हि धृतिरिति न चैतत् प्रीणितेऽकं । आपोऽधानेनैवाऽर्यस्याद्यवतानया</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="302,552 2180,544 2188,498 305,506" />
			<TextLine id="line_5">
				<Coords points="302,552 2180,544 2188,498 305,506" />
				<TextEquiv>
					<Unicode>श्रवणेऽत्र तु वेदकर्मणे दिनं न । श्रुतिश्चेतनसूत्रेण गृह्यपात्रायुध्येऽपि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="305,611 2195,602 2192,557 308,566" />
			<TextLine id="line_6">
				<Coords points="305,611 2195,602 2192,557 308,566" />
				<TextEquiv>
					<Unicode>प्ररोचनेन हि रात्र्युपवासकृतोऽस्ते । अत्र कर्मविधिनोऽविनाशनार्थेऽत्रणां पञ्चभूताः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
