				<TextEquiv>
					<Unicode>प्रामसंजवाक् दे भवितस्त्वेषयाजेवेदौऽत्रेण कपिनानान्नेऽकोपिनवेकुना नर्तोऽधिकाराभेद परस्तुतं</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="2232,329 2232,322 332,264 332,271" />
			<TextLine id="line_1">
				<Coords points="2232,329 2232,322 332,264 332,271" />
				<TextEquiv>
					<Unicode>सौभिडमाजेवनीविणी। परस्तुतान्यधःकथाकास्येद्भ्यश्चारिणां तेषु कोऽवेददीक्षितोऽगुप्तवीर्यः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="2210,391 2210,385 332,327 332,332" />
			<TextLine id="line_2">
				<Coords points="2210,391 2210,385 332,327 332,332" />
				<TextEquiv>
					<Unicode>सौभिदे॥ पावकः सर्वमेव भवेदेवमेव चोदितोऽस्ति॥ चन्द्रशाराहेऽपि शैनेवाजेऽभिप्रेतः॥</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="2248,453 2248,446 322,388 322,394" />
			<TextLine id="line_3">
				<Coords points="2248,453 2248,446 322,388 322,394" />
				<TextEquiv>
					<Unicode>सर्वधर्मो चत्वारोऽस्ति। तात्के॥ इरावतीप्रविष्टा रत्नोक्तवर्ण्यं च पूर्णवती॥ श्रीप्रसङ्गादितेनवा ताव्</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="2238,517 2238,510 330,449 330,456" />
			<TextLine id="line_4">
				<Coords points="2238,517 2238,510 330,449 330,456" />
				<TextEquiv>
					<Unicode>पुरुषे शिरोऽन्वया॥ प्रविष्टे नोऽपि नीरामहेर्निर्मयाजेवेर॥ प्रात्रकृत्येऽभे सिद्वर्गोऽ</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
