				<Coords points="305,272 2250,265 2235,192 305,195" />
				<TextEquiv>
					<Unicode>ॐ। पुत्रप्रभोऽसि कोऽत्र नो विचारतः प्रसङ्गसान्त्रतन्त्रकृतविरुद्धं चापि नृपसुखातुरेणात्र वलाद् धृतमेव</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="310,338 2208,332 2190,278 312,285" />
			<TextLine id="line_1">
				<Coords points="310,338 2208,332 2190,278 312,285" />
				<TextEquiv>
					<Unicode>पुत्रस्य मातुले।। हेमन्तस्मार्त्तनज्याये चान्यवाचनेऽत्र प्रीतिप्रहिणीतु तस्य च</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="302,399 2250,394 2240,339 302,346" />
			<TextLine id="line_2">
				<Coords points="302,399 2250,394 2240,339 302,346" />
				<TextEquiv>
					<Unicode>राधिकेऽत्र यासीत् केनिमच्चारभिः सकलुत्तमोऽपि।। सन्तापेनासवृत्तियाभ्यां काच</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="305,461 2278,455 2260,402 308,411" />
			<TextLine id="line_3">
				<Coords points="305,461 2278,455 2260,402 308,411" />
				<TextEquiv>
					<Unicode>नेकोरवीरास्ववत्ती तुवेधी यकञ्जले कान्यवेदेऽत्र। कोऽपि योऽस्मिन् तिष्ठेन्द्रियप्रवृत्तिन्तनोऽपि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="300,521 2215,516 2205,463 302,472" />
			<TextLine id="line_4">
				<Coords points="300,521 2215,516 2205,463 302,472" />
				<TextEquiv>
					<Unicode>आहेरे हृदयान्तरानुभूतिकावलीनचेतना।। इतिवादेऽकथयत्। सर्वधर्मस्ववृत्तिगोचरते</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="305,582 2248,576 2238,524 308,532" />
			<TextLine id="line_5">
				<Coords points="305,582 2248,576 2238,524 308,532" />
				<TextEquiv>
					<Unicode>हस्माग्रीवः।। जुष्टोऽपि तुर्वारिपुत्रस्य तावद्वचनम्।। विचार्यतेऽपि हित्वा विद्वान् यद्विचारि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="305,644 2295,638 2285,585 305,594" />
			<TextLine id="line_6">
				<Coords points="305,644 2295,638 2285,585 305,594" />
				<TextEquiv>
					<Unicode>योऽत्रैव। पुत्रप्रभविरहितः पार्थिवो विचारिणेऽत्र तत्रोऽस्मि राजेन्द्रेऽन्यो हि योऽत्र तिष्ठति</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="305,701 2260,694 2250,644 305,652" />
			<TextLine id="line_7">
				<Coords points="305,701 2260,694 2250,644 305,652" />
				<TextEquiv>
					<Unicode>मेघसाकुरराश्रयाभिवेगे भवति। इतोऽत्राहाररतेऽपि वासरेऽपि नरेन्द्रस्य</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
