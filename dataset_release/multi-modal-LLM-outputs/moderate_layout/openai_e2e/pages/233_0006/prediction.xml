				<Coords points="332,321 2245,315 2235,262 332,265" />
				<TextEquiv>
					<Unicode>सर्वेऽपि दन्ताः सकलेन्द्रिययुक्ता व्यतोऽत्र शूद्राचारप्रवृत्तानां चापि हेतवः।</Unicode>
				</TextEquiv>
			</TextLine>
