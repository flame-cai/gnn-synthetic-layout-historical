		<TextRegion id="region_1" custom="region_1">
			<Coords points="332,391 2292,383 2285,325 332,330" />
			<TextLine id="line_2">
				<Coords points="332,391 2292,383 2285,325 332,330" />
				<TextEquiv>
					<Unicode>तेषां ब्रह्मचर्यव्रतेनैव कर्मणां मेधाविनां परिः। बालस्य कामप्रवृत्तिवात्सल्याद्रुतमुक्तिरुच्यते।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_1" custom="region_1">
			<Coords points="322,462 2368,455 2360,393 322,396" />
			<TextLine id="line_3">
				<Coords points="322,462 2368,455 2360,393 322,396" />
				<TextEquiv>
					<Unicode>धर्मोऽसौ जनो देवेषु शास्त्री प्राहुः सदा। नास्तिकार्तेन कर्माणि यो विधत्ते परित्यजेत् पापं।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
