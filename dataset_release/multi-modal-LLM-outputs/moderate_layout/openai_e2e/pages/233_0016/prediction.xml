			<TextLine id="line_0">
				<Coords points="308,258 2135,256 2145,204 308,204" />
				<TextEquiv>
					<Unicode>श्रीमद्राजाधिराजपरमेश्वरश्रीनेन्द्रकृते वचः प्रपितृसंवत्सरं समाप्य श्रीः राजकोटिपालितोऽपि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="312,310 2122,308 2125,263 308,265" />
			<TextLine id="line_1">
				<Coords points="312,310 2122,308 2125,263 308,265" />
				<TextEquiv>
					<Unicode>वरः क्षितिवास्यत् पायोरुपदेशिनः पुनः ॥ इन्द्रधनीनोऽविवेकीयोऽप्येवकारणं ॥ मन्त्रयतेऽभ्यः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="310,363 2080,360 2080,318 308,319" />
			<TextLine id="line_2">
				<Coords points="310,363 2080,360 2080,318 308,319" />
				<TextEquiv>
					<Unicode>हस्तस्ववृत्तेनोक्तमभितः ॥ परयाकरस्थितियोगाद्धर्मेण रात्रौ ततो वाक्याद्योऽस्य कर्म चेष्ट्यम्</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="308,424 2092,420 2095,370 308,371" />
			<TextLine id="line_3">
				<Coords points="308,424 2092,420 2095,370 308,371" />
				<TextEquiv>
					<Unicode>श्रियेऽभिज्ञानम् ॥ इन्द्रविषयेऽपि चैत्रमासी नतान्कृपयेत् ॥ अहे दोषेऽसहसा नीतरस्येरे</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="308,483 2135,481 2135,430 308,431" />
			<TextLine id="line_4">
				<Coords points="308,483 2135,481 2135,430 308,431" />
				<TextEquiv>
					<Unicode>खण्डयुक्तिः ॥ उपासकपक्षिणां सधर्मयुक्तं वाङ्मयं राज्यमत्रान्तरेऽपि रमणेऽभ्यते कोऽनितरकः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="308,547 2132,543 2132,492 308,492" />
			<TextLine id="line_5">
				<Coords points="308,547 2132,543 2132,492 308,492" />
				<TextEquiv>
					<Unicode>विजेता ॥ प्रायेण तुन्नेऽपि पर्णपर्णितं चात्मनो हितं ॥ धर्मोऽयं कामोऽस्ति कोऽप्यप्याश्रितः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="308,611 2122,608 2125,554 308,554" />
			<TextLine id="line_6">
				<Coords points="308,611 2122,608 2125,554 308,554" />
				<TextEquiv>
					<Unicode>श्रीपतेः ॥ ध्याय कर्मणि वेदेऽप्यभिनेकीव्यापकारणे ॥ एते वचने रुद्रविवाहे तु मान्याः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="308,683 2092,677 2090,619 308,620" />
			<TextLine id="line_7">
