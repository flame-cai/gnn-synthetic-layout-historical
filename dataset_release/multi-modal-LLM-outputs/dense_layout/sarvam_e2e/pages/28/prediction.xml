			<Coords points="" />
			<TextLine id="line_0">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>२४</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_1">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>ग्रंथकर्तृभिः</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_2">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>उक्तचतार्षपां तिथि२प्राश्चिष्ठुक्लदशम्पा=३</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_3">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>धनेलेचियत्तैलं साभिजिच्छस्तापौत्समानदुक्तममुखैः कार्यापरेमिबुधैः ३६ भद्रासंक्रमपातवैधृतिसितेज्या</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_4">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>प्रभवासितंद्रयां कीरबस्थादिषुश्राहे‘प्रतिपद्यये७।न।९।१।११।१२।१३।१४।३।१५।१२परिहरेद्वेतुंविनाभ्यंजनें</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_5">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>तरयुतं चापि नटु मांगला विजयोन्सवोऽवरनंदीपावलीहितवौम्पंगस्पकैथितादितैलमंनसन्निद्यैर्हि‘नित्यै</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_6">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>खविलं ३७ दिग्विश्र-प्रा१३दि०९६२गंक९दर्शी३तिथिमूस्नानैनधात्रीफलैःश्रीकामोर्थ</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_7">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>वीभौमवारेचम बुधावुपर्धीपि तथाभ्यंगात्यनि ‘गना’ पुत्रीसोमहिनेप्रसर्यमथितत्वाकेन्द्रमिश्त्रावुप</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_8">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>कव्यादेश्वरमेकुपुत्रहारजेस्वायानिशास्तेपिच’ ३८ मदारान्नदिनैमडुध्रुवचरचिप्रैर्वलेनदोसुधायो</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_9">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>स्वानसुखात्महं=३ जैमेयजमाचरैस्तमुत्तिकेंद्रारिवयोगैमिअकू’ तद्दद्यादिहविद्भवेदुतनयप्रद्योतनैरोजिणोऽसकृाव</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_10">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>व्रणकर्मसूर्यकुनपौःरहीहैकेन्द्रेस्थयोः * वाम्याहित्रयवामूलजलपोपानेंद्रहस्तावुमैशगत्यार्जद्विपयोः</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_11">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>नृपै१हूर्नवर्दिनैरन्यरुग्णाविरुकू’ प्रादियाघनिलघ्वंत्यपितरमेंक्रेंदुवारैगदत्यक्तस्नानर्मिष्टे</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_12">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>मिष्टमश्रमेभादौरवलास्तस्थिरे ४० द्रव्यंसमवहातो लघुचरैर्योग्येचरागेवुधैधर्माष्टा ०मजगर्थेत</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_13">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>कुत्सितं पुत्रस्थानं यस्मिनेतदृशेलग्नेविच=५ पुनर्वसुः=२२प्रोमधं=४ हवींकेफ्रवद्विधिरविचाररहिते=४</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_14">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>पेखुजोक्तकाले=३ ५६कजयोः=४ मेखत्यारोगमुक्ति=२ देवेग्राहादिविषहर=१</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_15">
				<Coords points="" />
				<Baseline points="" />
				<TextEquiv index="0">
					<Unicode>* शांत्यारोगमुक्तिस्प</Unicode>
				</TextEquiv>
			</TextLine>
			<TextLine id="line_16">
