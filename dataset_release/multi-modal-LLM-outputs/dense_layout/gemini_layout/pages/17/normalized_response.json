{
  "text": {
    "1": "स्वस्मात्पंचमः परेशः",
    "0": "कन्यायुक्तव्यतिरिक्तचत्वारो राशयः २।३।५।१०=२",
    "4": "उर्येषां==२",
    "3": "अन्यवर्गयुक्तः==२",
    "2": "बलवंतो भवंति==२",
    "5": "पूर्वदिक्कसकाशा",
    "38": "त",
    "6": "क्रिये घट २।९ कोर्प्पिट उजौ ३ याम्यतो मध्ये न्यै नव संत्येथेंद्रक कुंभो वर्गः स्युरोजे",
    "7": "स्विनः ८६ अष्टावुप्रमुखाः स्वपंचमपरादिघ्नः स्ववर्गैर्युक् ततः काकिणिकांग",
    "8": "जैर्विमिश्रैमायस्याधिका सौर्यदैः श्वेता रक्तक पीत कृष्ण वसुधा स्वादुः कटुस्तिक्तकाः",
    "9": "८९",
    "10": "विप्रादितः क्रमात्",
    "11": "काषाया घृतशोणितान्नमदिरागंधा शुभा विप्रातः ८९ सौम्यादिप्लवभूतलै विरचये",
    "12": "ब्राह्मणाः=५",
    "13": "उत्तरादिनतम्",
    "14": "द्विप्रदिकोऽन्येष्वखिले नान्येषानियमोऽत्र यत्ननिखिलाः कुर्युर्गृहं हस्तिस्थिरं स अप्रक्षक",
    "15": "मो विप्रादिको गृहं",
    "16": "विप्रादयः=५",
    "17": "विरच्येत=४",
    "18": "स्वप्राकाश्यस्थले=५",
    "19": "तो मुखा प्रथमतो वर्गादिवर्लोकितं मन्मेतद्दिगतामादिशेत्तु हयपैः शल्पैः सुधीर्मेधतः ८८",
    "20": "लोहाद्यस्य गारादि=६",
    "21": "८८",
    "22": "स्वभ्रं हस्तमितं खनेदिह जलैः पूर्णं निशास्थे न्यसेत्प्रातर्दृष्ट जलं स्युत्तु सदजलं मध्यंत्वसं",
    "23": "सजनत्वं नृत्वा",
    "24": "२",
    "25": "यावज्जलान्निःस",
    "26": "त्स्फारितं ज्ञात्वैवं निखनेद्गृहाधिकमुभं वेत्वा जलं तस्तरो यावद्वा पुरुषस्ततः कपिशि",
    "27": "रतिप्रथवाप्येत",
    "28": "रस्तु त्याप्रभृतिः सरयेत् ८९ प्राक्साध्योज्जयिनीस्थ लाघमदिति त्वाद्यानिलाभ्यां तरा",
    "29": "हस्ति को द्यात",
    "30": "पातादि उत्तरः",
    "31": "प्राग्भवति=१",
    "32": "मृत्तिका पुटं पुरुष",
    "33": "त्सोम्येऽतोऽन्युदयोदुदक्ध्रुवमुखादिग्मूटके स्यान्मृतिः ९० गेहं माधव पोषफाल्गुन न",
    "34": "प्रमाणं वानि खने",
    "35": "उज्जयिनीमारभ्य दक्षिणाशायां स्थितैर्नरैः चित्रास्वात्योः उदये मध्यभागे प्राक्साध्या=२",
    "36": "त=२",
    "37": "उज्जयिन्याः सोम्ये च संमुखो निविडांतरालेति कोदये प्राक्साध्या="
  },
