{
  "text": {
    "0": "जन्मकाले चंद्रो न गणाश्च उपचयस्थानस्थिता राशयः यात्रां बलंगताः शुभा भवंति = ५",
    "1": "जन्मकाले स्वराशि उच्चराशि मित्रराशिगताः पापा अपि तनुगताः शुभा भवंति = ५",
    "2": "विदशाकमेलाह =",
    "3": "मित्रगृहस्थवा सरे लग्ने वा पोपि शुभः = ६",
    "5": "जन्मराशि जन्मल",
    "6": "जो वा शकुञ्जः ऐश्यादिदिग्गतोगुरुर्ज्वलनदिग्गयाये मयैस्थो भृगुर्वा योषद् सुतगो विधुर्निकृ",
    "7": "ग्नेशशत्रुः = २",
    "8": "लग्ननवांशादि २",
    "9": "तिदिग्गयाके संस्येतमः २४ वक्री केंद्रगतस्तारीयदिवसो लग्ने स्ववर्गे भवेद्यातु र्नाशकरः शुभो",
    "11": "सूर्यादिग्रह जन्मर्क्षा",
    "12": "जन्मानि सूर्यस्या",
    "13": "पितनुगो जन्मेशलग्ने रिपुः दीशान्वं वजभाग्यभानि गुरुभं वो ह्मातके सावर्भं जन्मर्त्ता",
    "14": "ना द्विती यस्थाने वे",
    "15": "णि = २",
    "16": "रे वैरूप्यवगतः खेटस्तैनौहानिकृत २५ वैशिः सौम्ययुतस्तनौ जनुषि ये सद्रियुता राशयो",
    "17": "सूर्यादितः क्रमेण =",
    "18": "शिः = ४",
    "19": "जन्माओपचयस्थिता अपि तनोः स्वोच्चे मित्रर्त्तगाः पापा अप्यतिशोभना तनुगता जन्मेभ्व",
    "20": "जन्मनि = ५",
    "21": "अस्पजन्मभं विवि",
    "22": "जन्मराशि जन्म",
    "23": "धोयात्तहतं असौ",
    "24": "रौ केंद्रगो स्वारी त्यरितनौ शुभो न फलदो मित्रो हि पापोर्यदः २६ आद्याद्यन्य रारा पापा तारा",
    "25": "लग्नेश्वरो केंद्रगो",
    "26": "ग्रहो लग्नगो हानि",
    "27": "१२२ गताः खलाः ख २२ ईनें जो वों त्याद्यषका ष २२।६।८ गो भूयः सोपचितोस्त ७ खा २२ दुष्टसुते ५",
    "28": "भवतः = ५",
    "29": "कृद्धवति = ४",
    "30": "विप्रायश्चन्न",
    "31": "गः भृकोस्तैज्योमंतो नैव ह्यौ य २२ गो ग्रहन्वित शशी यातुर्महाविप्रदाः अन्यस्यानुगता",
    "32": "स्वजन्मराशिस्वज",
    "33": "दिश्या एतेभ्यः अन्यः",
    "34": "न्मलग्नेशशत्रुवास्त",
    "35": "जयार्थ सुखदा दुष्टं पुरो से न चेत् २७ स्वग्रामे के पुरा लसद्यसुचतुर्वक्रे चतुःशालके तद्वा",
    "36": "= ६",
    "37": "= त्याज्यं",
    "38": "रे = ६",
    "39": "भृग्वादिगोत्रा",
    "40": "हैचवधूप्रवेशनृपभी हुम्तिपीडासुच तीर्थस्वामिनिदेशयो र्भृगुवशिष्ठांगिरः काश्यपे",
    "41": "आस्तः = ८",
    "42": "णा = ३",
    "43": "भारद्वाजवात्स्ययो हितकरं यानं सितज्ञोन्मुखं २८ चंद्रहषभमेषगे सति सितो धः स्या",
    "44": "त्तदासन्मुखं यानं सत्सरस्वयोः सितविपर्यसात्सदावश्यकें राजा तर्पितवह्निभूसुरसुहृत्",
    "45": "गमनगस्तये सितश्चेत्पूर्वदिशि तदा पश्चिमयात्रा पश्चिमे चेत्तदा पूर्वदिग्यात्रा",
    "46": "कर्त्तव्या गोत्तममरीत्यैवै सन्मुखशुक्रपरिहारः = १",
    "47": "CC-0 Dharmartha Trust J&K. An eGangotri-Vaidika Bharata Initiative"
  },
