				<TextEquiv>
					<Unicode>द्वयोरयनेक्ये तशरात्रौ दिवा वा गच्छेत भेदे सति दिने सूर्य्यनुकूलेन रात्रौ चंद्रानुकूलेन दो चेदुत्तरायणे तदा हनिशं</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
