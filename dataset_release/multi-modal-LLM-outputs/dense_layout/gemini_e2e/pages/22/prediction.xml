			<TextLine id="line_1">
				<Coords points="490,211 3059,211 3059,123 490,123" />
				<TextEquiv>
					<Unicode>उदग्गमनं हो चेत्तद्दक्षिणायने तदा हर्निशं दक्षिणगमनं प्राची फलमुत्तरवत् प्रतीची दक्षिणवत् रत्नकोशे दि</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="490,281 2538,281 2538,193 490,193" />
			<TextLine id="line_2">
				<Coords points="490,281 2538,281 2538,193 490,193" />
				<TextEquiv>
					<Unicode>नकररजनीकरयोर्मकराशौत्तरां च सर्वाच्च यायाच्च कर्कटाद्दो याम्यामाशां प्रतीचीं = ४</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="490,404 2996,404 2996,290 490,290" />
			<TextLine id="line_3">
				<Coords points="490,404 2996,404 2996,290 490,290" />
				<TextEquiv>
					<Unicode>रगौर्यार्द्रार्द्रावरुणके हित्वाभूर्त्तं मनिष भैर्य्यदि निजोडपो चांग लब्धि वर्जित ८ मिश्रा</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="490,492 3038,492 3038,385 490,385" />
			<TextLine id="line_4">
				<Coords points="490,492 3038,492 3038,385 490,385" />
				<TextEquiv>
					<Unicode>खवध्रुवभैर्दिनादिमलवै तीत्तो हि तीयौति मै हि प्रैर्न क मशो गृहगुचरभैरा वि त्रिभागोद्वियो</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="490,581 3038,581 3038,473 490,473" />
			<TextLine id="line_5">
				<Coords points="490,581 3038,581 3038,473 490,473" />
				<TextEquiv>
					<Unicode>तर श्रुत्यर्कै ज्यमगेध्व्यं न नियमौ वैश्वोत्तरादः श्रवस्तियं रपस्त्वभिजित्मेसफलदो यामी</Unicode>
				</TextEquiv>
			</TextLine>
