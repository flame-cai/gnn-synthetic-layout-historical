      "lines": [
        {
          "id": "line_0",
          "box_2d": [
            33,
            145,
            114,
            762
          ],
          "text": "जन्मकाले चंद्रो तन्गाश्चोपचयस्थानस्थिता राशयः यात्रां बलन् गताः शुभा भवंति = ५"
        },
        {
          "id": "line_1",
          "box_2d": [
            88,
            268,
            153,
            955
          ],
          "text": "विद्वणकमेलाह = जन्मकाले स्वराशि उच्चराशि मित्रराशि गताः पापा अपि तनुगता शुभा भवंति = ५"
        },
        {
          "id": "line_2",
          "box_2d": [
            119,
            466,
            169,
            762
          ],
          "text": "मित्रगृहस्थ वा स्वराशौ लग्ने वा पि बुधः = ६"
        },
        {
          "id": "line_3",
          "box_2d": [
            147,
            144,
            250,
            836
          ],
          "text": "ज्ञो वा शुकुज्ञः ऐश्यादि विग तो गुरुर्ज्वल नदिष्या यै यै स्यो भगवौ यो षह सुत गो विधुर्निकृ"
        },
        {
          "id": "line_4",
          "box_2d": [
            221,
            144,
            308,
            878
          ],
          "text": "ति दिष्या के संस्येतमः २४ वक्री केंद्रगतस्तारीय दिवसो लग्ने स्ववर्गे भवे द्यातु र्नाशकरः शुभो"
        },
        {
          "id": "line_5",
          "box_2d": [
            261,
            144,
            351,
            868
          ],
          "text": "पितनुगो जन्मैर्शलग्ने रिपुः दीशान्यं वै ज भाग्यभा नि गुरु भं वो ह्मा तके सा वर्म जन्मतो"
        },
        {
          "id": "line_6",
          "box_2d": [
            318,
            144,
            404,
            868
          ],
          "text": "रै वै रूप प्लवगतः खेटस्तै नौ हानि कृत २५ वैशिः सौम्ययुतस्तनो जनुषि ये स द्वि युता राशयो"
        },
        {
          "id": "line_7",
          "box_2d": [
            381,
            144,
            461,
            868
          ],
          "text": "जन्मा चो पचयस्थिता अपि तनोः स्वहोच्च मित्रैर्गताः पापा अप्यतिशोभना तनुगता जन्मेष्व"
        },
        {
          "id": "line_8",
          "box_2d": [
            438,
            144,
            518,
            868
          ],
          "text": "रौ केंद्र गो स्वा रौ त्यरि त नौ शुभो न फल दो मित्रो हि पापोर्यदः २६ आद्या यन्य रारा पापा तारा"
        },
        {
          "id": "line_9",
          "box_2d": [
            495,
            144,
            575,
            868
          ],
          "text": "१२२ गताः खलाः ख२२ ईनें जो वों त्याद्यषका ष २२।६।८ गो भूयः सोपचितोस्त ७ खा२२ दुष्ट सुतप"
        },
        {
          "id": "line_10",
          "box_2d": [
            545,
            144,
            625,
            868
          ],
          "text": "गः शुकौ स्तर जो मंतो नैव ह्यौ य २२ गो ग्रह हानित शशी यातुर्महाविघ्नदाः अन्यस्थानगता"
        },
        {
          "id": "line_11",
          "box_2d": [
            595,
            144,
            675,
            868
          ],
          "text": "जयार्थ सुखदा दुष्टं पुरो र्के न चेत् २७ स्वगामैके पुरा लसद्य सुचतुर्वक्रे चतुः शाल के त हा"
        },
        {
          "id": "line_12",
          "box_2d": [
            645,
            144,
            725,
            868
          ],
          "text": "है वधूप्रवेशनृपभी हु मिस्ति पीडा सुच तीर्थस्वामि निदेशयो र्भृगु वशिष्ठा अंगिरः काश्यप"
        },
        {
          "id": "line_13",
          "box_2d": [
            695,
            144,
            775,
            868
          ],
          "text": "भारद्वाज वा त्स्यो हित करं या नंसितज्ञोन्मुखं २८ चंद्रो वृषभमेषगे सति सितो धः स्या"
        },
        {
          "id": "line_14",
          "box_2d": [
            745,
            144,
            825,
            868
          ],
          "text": "त्तदासन्मुखं या नंस तर सर्वयोः सित वि पर्यसात्सदावश्यकै राजा तर्पित वह्नि भूसुर सुहृत्"
        },
        {
          "id": "line_15",
          "box_2d": [
            795,
            344,
            865,
            868
          ],
          "text": "गमन ग सये सितश्चे पूर्व दिशि तदा पश्चिम यात्रा पञ्चिमे चेत्तदा पूर्व दिग् यात्रा"
        },
        {
          "id": "line_16",
          "box_2d": [
            845,
            400,
            915,
            762
          ],
          "text": "कर्त्तव्या गोत् भ्रमरी त्यै वै सन्मुख शुक्र परिहारः = १"
        }
      ]
    },
