      "lines": [
        {
          "id": "line_0",
          "box_2d": [
            160,
            130,
            260,
            860
          ],
          "text": "क्रिये घट २१ कोर्प्पिट उजौ ३२ याम्यतो मध्ये न्यै नव संत्यैंद्र क कु मो वर्गाः स्यु रोजे"
        },
        {
          "id": "line_1",
          "box_2d": [
            250,
            130,
            340,
            860
          ],
          "text": "स्विनः ८६ अष्टावु प्रमुखाः स्वपंचम परा दिग्भः स्ववर्गैर्नियुक् तद्वः काकिणिकांग"
        },
        {
          "id": "line_2",
          "box_2d": [
            320,
            130,
            410,
            860
          ],
          "text": "जैंट र्मिष इमा यस्याधिका सौर्यदः श्वेता रक्त क पीत कृष्ण वसुधा स्वादुः कटु स्तिक काः"
        },
        {
          "id": "line_3",
          "box_2d": [
            400,
            130,
            480,
            860
          ],
          "text": "काषाया घृत शोणितान्न मदिरा गंधा शुभा विप्रतः ८१ सौम्यादिप्लवभूतलैरिव रचये"
        },
        {
          "id": "line_4",
          "box_2d": [
            470,
            130,
            540,
            860
          ],
          "text": "द्विप्रदिकोऽन्येष्विले नान्येषा नियमोत्र यत्र निखिलाः कुयुर्गृहं हस्तिस्थरं स अप्रक्षक"
        },
        {
          "id": "line_5",
          "box_2d": [
            530,
            130,
            610,
            860
          ],
          "text": "तो मुखा त्प्रथम तो वर्गादिव लो किम मे तद्दिगता मा दिशो गृह यपैः शल्पैः सुधार्मेधपतः ८८"
        },
        {
          "id": "line_6",
          "box_2d": [
            600,
            130,
            670,
            860
          ],
          "text": "स्वभ्रं हस्तमितं खने दिह जलै पूर्रा निशायें न्य से त्प्रा त र्हष्ट जलं स्यु तं सदज लं मध्यं त्वसं"
        },
        {
          "id": "line_7",
          "box_2d": [
            660,
            130,
            740,
            860
          ],
          "text": "त्स्फाटितं ज्ञात्वैवं निखने गृह अधिकं भुवेन त्वौज लांतस्त रो याव द्वापुरुषस्ततः कपिशि"
        },
        {
          "id": "line_8",
          "box_2d": [
            730,
            130,
            810,
            860
          ],
          "text": "रस्तु त्या प्रमभिः पूरयेत् ८९ प्राकृसाध्योज्जयिनीस्य लोधमदित्वा थानिलाभ्यांतरा"
        },
        {
          "id": "line_9",
          "box_2d": [
            790,
            130,
            870,
            860
          ],
          "text": "त्सोम्येऽतोऽन्युदयोदु क ध्रुव मुखा दिग्मूटके स्यांस्त तिः ९० गेहं माधव पो षफाल्गुन न"
        }
      ]
