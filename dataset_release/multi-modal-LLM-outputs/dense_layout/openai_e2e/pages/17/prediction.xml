				<Coords points="518,329 3420,329 3420,243 518,243" />
				<TextEquiv>
					<Unicode>त्रयोदशमे कोटि उपगे सोमदेवमध्यमे चैव स्तोत्रे के कुचोऽभयोऽऽस्त्रयोऽभि।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="518,426 3409,426 3409,338 518,338" />
			<TextLine id="line_1">
				<Coords points="518,426 3409,426 3409,338 518,338" />
				<TextEquiv>
					<Unicode>हिनः तद् ऋषयोऽभ्युद्युक्ताः स्वेधर्मपतये हि यः स्वप्नेऽप्युपेत्य तद् कथितं किं</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="511,529 3437,529 3437,437 511,437" />
			<TextLine id="line_2">
				<Coords points="511,529 3437,529 3437,437 511,437" />
				<TextEquiv>
					<Unicode>श्रेयं विप्रस्य मध्यस्माधिकस्याध्येऽपि चेतोऽस्ते के पतिहस्तस्य च दुःखस्य च केऽपि।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="508,627 3440,627 3440,535 508,535" />
			<TextLine id="line_3">
				<Coords points="508,627 3440,627 3440,535 508,535" />
				<TextEquiv>
					<Unicode>काम्या हेतवोऽभवन्निति केन चिरं यथा सुमुखाः प्रीताः तु सोम्यादिव्यधनस्तलेखितेऽभ्ये</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="518,722 3437,722 3437,635 518,635" />
			<TextLine id="line_4">
				<Coords points="518,722 3437,722 3437,635 518,635" />
				<TextEquiv>
					<Unicode>दुःखो हि काम्योऽस्ति नान्यधनानि यथैव प्रीतानि। कयाचित् तत्र सिद्धस्य स्वदेशभिन्नां</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
