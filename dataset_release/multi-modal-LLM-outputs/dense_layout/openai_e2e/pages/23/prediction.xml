			<TextLine id="line_13">
				<Coords points="532,1308 3255,1308 3255,1234 532,1234" />
				<TextEquiv>
					<Unicode>भवति च जन्मादौ स्वभावविशेषः कर्मविशेषानुरोधेन।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
