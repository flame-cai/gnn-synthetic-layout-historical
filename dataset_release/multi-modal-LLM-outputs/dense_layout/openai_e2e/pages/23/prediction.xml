		<TextRegion id="region_0" custom="region_0">
			<Coords points="528,144 3108,144 3108,56 528,56" />
			<TextLine id="line_0">
				<Coords points="528,144 3108,144 3108,56 528,56" />
				<TextEquiv>
					<Unicode>जन्मकाले चेहते तत्र तावद्रूपेण व्यवस्थानं भवति तत्रार्थः प्राणी बलवन्तः। पुनर्भवति—</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="952,227 3227,227 3227,149 952,149" />
			<TextLine id="line_1">
				<Coords points="952,227 3227,227 3227,149 952,149" />
				<TextEquiv>
					<Unicode>विशेषकारणम् = जन्मकाले स्थितिरोजो राशिविशेषात् गुणतोऽपि परिश्रमाद् इत्युपपत्तिः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="528,324 3255,324 3255,239 528,239" />
			<TextLine id="line_2">
				<Coords points="528,324 3255,324 3255,239 528,239" />
				<TextEquiv>
					<Unicode>नो वा कृतान्तः। तेषां हि चित्तगोचरैः कर्मभिः स्वभावव्यवस्थानम् उपपद्यते।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="532,412 3308,412 3308,330 532,330" />
			<TextLine id="line_3">
				<Coords points="532,412 3308,412 3308,330 532,330" />
				<TextEquiv>
					<Unicode>त्रिविधगुणादिभिः सप्तभिः। यद् वैको कारणं तद्विरोधिनोऽपि जन्मकर्मणि प्रवर्तन्ते।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="525,501 3248,501 3248,422 525,422" />
			<TextLine id="line_4">
				<Coords points="525,501 3248,501 3248,422 525,422" />
				<TextEquiv>
					<Unicode>विचित्रगुणेनैव लोकस्य धर्मिपर्यायः। केषांचिद् जन्मना हि स्मृतिः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="525,592 3227,592 3227,512 525,512" />
			<TextLine id="line_5">
				<Coords points="525,592 3227,592 3227,512 525,512" />
				<TextEquiv>
					<Unicode>वैचित्र्यम् एव कर्मणो विपाकहेतुत्वात्। दोषाणां च जन्मान्तरप्रवृत्तिः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="536,679 3252,679 3252,601 536,601" />
			<TextLine id="line_6">
				<Coords points="536,679 3252,679 3252,601 536,601" />
				<TextEquiv>
					<Unicode>यदेव कारणमिति ख्यायते तदेव भाविनो हेतुः। द्विविधोऽपि भावः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="525,766 3262,766 3262,690 525,690" />
			<TextLine id="line_7">
				<Coords points="525,766 3262,766 3262,690 525,690" />
				<TextEquiv>
					<Unicode>जन्मनोऽपि पञ्चधा व्यवस्था उपपत्तेः। स्वकर्मप्रवृत्तौ चापि विशेषः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="525,858 3206,858 3206,779 525,779" />
			<TextLine id="line_8">
				<Coords points="525,858 3206,858 3206,779 525,779" />
				<TextEquiv>
					<Unicode>यथैव हि स्वभावो नित्यः कर्मणोऽपि फलत्वमिति स्वभाववादिनः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="528,948 3262,948 3262,869 528,869" />
			<TextLine id="line_9">
				<Coords points="528,948 3262,948 3262,869 528,869" />
				<TextEquiv>
					<Unicode>गुणकर्मविभागेन तत्त्वतोऽभ्युपगमात्। न चैतद् विरुध्यते।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="518,1042 3216,1042 3216,961 518,961" />
			<TextLine id="line_10">
				<Coords points="518,1042 3216,1042 3216,961 518,961" />
				<TextEquiv>
					<Unicode>ननु कर्मणः फलमित्युक्ते कारणकार्यम् एवोपपद्यते।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="522,1131 3244,1131 3244,1055 522,1055" />
			<TextLine id="line_11">
				<Coords points="522,1131 3244,1131 3244,1055 522,1055" />
				<TextEquiv>
					<Unicode>कथं चान्यथा पूर्वकृतकर्मणो जन्मविशेषो भवेत्।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="528,1223 3258,1223 3258,1140 528,1140" />
			<TextLine id="line_12">
				<Coords points="528,1223 3258,1223 3258,1140 528,1140" />
				<TextEquiv>
					<Unicode>यदुक्तं स्वभावो हेतुरिति, तन्न; कर्मण एव हेतुत्वोपपत्तेः।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
