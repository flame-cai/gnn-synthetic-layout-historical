				<TextEquiv>
					<Unicode>मिनेन्द्रकृतौ प्रकरणमुक्तयः । २० शोकलोऽप्युद्देश्यहि ध्येयपदविधे कर्तव्योऽत्राकविधिभेदेऽभ्यस्त्रविधिरखिलहरेणोऽन्योऽभिधानेन</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="287,323 3325,322 3339,239 287,237" />
			<TextLine id="line_3">
				<Coords points="287,323 3325,322 3339,239 287,237" />
				<TextEquiv>
					<Unicode>चः सिद्धेर्महिका क्षमोऽस्त्वखल्वेकान्तलोकीर्णो भोग्यः प्रवर्तकोऽस्ति मेधारयोः सद्यजेते २० मे श्रोमणिप्रभृतीनां</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
