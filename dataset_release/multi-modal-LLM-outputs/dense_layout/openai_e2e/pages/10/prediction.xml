			<TextLine id="line_0">
				<Coords points="273,138 3332,109 2415,57 287,63" />
				<TextEquiv>
					<Unicode>विन्ध्याद्रिप्रति नो भोगमयी नाट्यरूपः सर्वविधो भवेन तद्वर्तिनोऽभ्यस्तेऽनुलोपेऽथ सदैनमभिदत्तप्रश्नेन । परम्परायां पद्यतत्त्वप्रवृत्तेऽप्यभिधातृभवतः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="2650,207 3328,193 3342,133 2660,141" />
			<TextLine id="line_1">
				<Coords points="2650,207 3328,193 3342,133 2660,141" />
				<TextEquiv>
					<Unicode>नरः प्रवेक्ष्यतेऽथाकुङ्क्षधृतश्चूलोऽस्त्रयोगः ।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="287,228 3322,237 3283,151 280,144" />
