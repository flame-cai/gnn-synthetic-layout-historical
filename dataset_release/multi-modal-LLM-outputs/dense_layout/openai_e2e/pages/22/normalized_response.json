            ]
          ],
          "box_2d": [
            109,
            146,
            148,
            782
          ],
          "text": "न कर्तृजनो केचिदभेदेनैवेत्यत्रावयवेऽप्यर्थे कैर्योग्यमाचार्यते चेन ।"
        },
        {
          "id": "line_3",
          "polygon_2d": [
            [
              169,
              147
            ],
            [
              164,
              902
            ],
            [
