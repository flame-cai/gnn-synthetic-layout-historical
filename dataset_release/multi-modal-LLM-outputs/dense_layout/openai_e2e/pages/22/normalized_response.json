            [
              214,
              146
            ]
          ],
          "box_2d": [
            164,
            146,
            214,
            902
          ],
          "text": "स्यादिति यद्युक्तमुपपत्तेः किं त्वभिप्रेतार्थकृत्यविधिनियोगविधौ नियमोऽभ्युपगम्यतेऽत्र"
        },
        {
          "id": "line_4",
          "polygon_2d": [
            [
              218,
              146
            ],
            [
              213,
              923
            ],
            [
