			<TextLine id="line_0">
				<Coords points="518,104 3258,96 3248,35 514,39" />
				<TextEquiv>
					<Unicode>द्रोणमेकं ततोऽनेके द्रोणोऽभवन् भूरिभेदाः सिध्यन्ते सन्ध्येऽप्येवं नान्यत्र चेद्वस्तुनिहिते</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="511,172 3255,164 3266,106 514,110" />
			<TextLine id="line_1">
				<Coords points="511,172 3255,164 3266,106 514,110" />
				<TextEquiv>
					<Unicode>धर्ममने द्रोणे स्यात् प्रायश्चित्तविधानिर्दिष्टेऽपि मनसि प्रवर्तते तद्वद्विवेकाः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="511,234 2737,226 2726,172 511,175" />
			<TextLine id="line_2">
				<Coords points="511,234 2737,226 2726,172 511,175" />
				<TextEquiv>
					<Unicode>न कर्तृजनो केचिदभेदेनैवेत्यत्रावयवेऽप्यर्थे कैर्योग्यमाचार्यते चेन ।</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="511,338 3157,327 3157,259 514,267" />
			<TextLine id="line_3">
				<Coords points="511,338 3157,327 3157,259 514,267" />
				<TextEquiv>
					<Unicode>स्यादिति यद्युक्तमुपपत्तेः किं त्वभिप्रेतार्थकृत्यविधिनियोगविधौ नियमोऽभ्युपगम्यतेऽत्र</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="514,417 3238,406 3230,336 511,344" />
			<TextLine id="line_4">
				<Coords points="514,417 3238,406 3230,336 511,344" />
				<TextEquiv>
					<Unicode>व्यवहारमेवेदमभिधीयते योऽयं विहितोऽपि स कर्मणि न प्रवर्तते यत्प्रकारेण विधिमात्रार्थकत्वम्</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="514,499 3248,486 3252,413 518,424" />
			<TextLine id="line_5">
				<Coords points="514,499 3248,486 3252,413 518,424" />
				<TextEquiv>
					<Unicode>तत्र च प्रयोजनमत्रैव यन्न विधिमात्रेणैवोपपद्यते तस्मात् कर्मणोऽर्थोऽपि विध्यपेक्षया</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="514,574 3276,563 3269,495 514,505" />
			<TextLine id="line_6">
				<Coords points="514,574 3276,563 3269,495 514,505" />
				<TextEquiv>
					<Unicode>विनियोगेऽस्त्यत्र । एकोऽप्युद्देशोऽनेकेषु विधिषु प्रयुज्यते ततोऽर्थवद्विधिनियमः</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
		<TextRegion id="region_0" custom="region_0">
			<Coords points="511,655 3234,642 3234,573 511,584" />
			<TextLine id="line_7">
				<Coords points="511,655 3234,642 3234,573 511,584" />
				<TextEquiv>
					<Unicode>तस्मादर्थप्रयुक्तो विधिरेव । तत्र कर्मणोऽभिप्रायोऽपि करणीय इति चेद् यथाश्रुति</Unicode>
				</TextEquiv>
			</TextLine>
		</TextRegion>
